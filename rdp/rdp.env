# RDP target lab — single source of truth. Sourced by every script here.
# Inherits identity/network from ../lab.env; only RDP-specific facts live here.

RDP_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
. "$RDP_DIR/../lab.env"

# --- targets ----------------------------------------------------------------
# .10-.14 are DCs, .20-.29 are clients. RDP targets take .30 and .31.
RDP_BASE=30
rdp_name() { echo "rdp$1"; }
rdp_ip()   { echo "${NET_PREFIX}.$((RDP_BASE + $1 - 1))"; }
RDP_COUNT=2

# rdp1 is domain-joined (sssd+pam+krb5). rdp2 stays standalone so the local
# credential path is proven on a host that has no sssd in the stack at all.
RDP_JOINED=1

IMG_RDP="localhost/ad-rdp:latest"

# --- accounts ---------------------------------------------------------------
LOCAL_USER="rdplocal"                       # local unix account inside both targets
DOMAIN_USER="rdpuser"                       # AD account, created on dc1

LOCAL_PASS_FILE="$SECRET_DIR/rdplocal.pass"
DOMAIN_PASS_FILE="$SECRET_DIR/rdpuser.pass"

EVIDENCE_DIR="$RDP_DIR/evidence"

# Generate a password only if absent. Never echoed, never on a command line.
# AD complexity: upper + lower + digit + symbol.
gen_pass() {   # $1 = target file
    local f="$1"
    [[ -s "$f" ]] && return 0
    # Never create SECRET_DIR here — see the same refusal in 10-build.sh. A
    # generator that makes its own directory will happily mint a credential at
    # a dead path and report success.
    [[ -d "$SECRET_DIR" ]] || {
        echo "FATAL SECRET_DIR=$SECRET_DIR does not exist; refusing to generate a" >&2
        echo "      credential into a directory this script would have invented." >&2
        echo "      Create it once, as root:  install -d -m 0700 $SECRET_DIR" >&2
        return 1; }
    python3 -c "import secrets,string; a=string.ascii_letters+string.digits; \
print(''.join(secrets.choice(a) for _ in range(24)) + '!aA1', end='')" > "$f"
    chmod 600 "$f"
    echo "  generated -> $f (mode 600, not printed)"
}
