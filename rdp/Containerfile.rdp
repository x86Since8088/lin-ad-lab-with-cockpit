# RDP target: xrdp + a lightweight XFCE desktop, with the full domain-member
# identity stack so PAM logins can be satisfied by sssd against a real DC.
#
# Session backend is Xvnc, not xorgxrdp — a deliberate choice, not a measured
# one: xorgxrdp starts a real Xorg, which expects a VT and a seat that a
# container does not have, while Xvnc is pure userspace and needs neither.
# xorgxrdp was never installed here, so this is an avoided risk rather than an
# observed failure. xrdp.ini sets autorun=Xvnc so no session type is ever
# offered to the client.
FROM docker.io/library/ubuntu:latest
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        xrdp tigervnc-standalone-server \
        xfce4-session xfwm4 xfdesktop4 xfce4-panel xfce4-terminal \
        xfconf thunar mousepad dbus-x11 \
        xterm x11-apps x11-utils x11-xserver-utils xdotool \
        fonts-dejavu-core openssl \
        adwaita-icon-theme hicolor-icon-theme librsvg2-common \
        shared-mime-info libgtk-3-bin at-spi2-core \
        sssd sssd-ad sssd-tools libnss-sss libpam-sss adcli realmd \
        samba-common-bin krb5-user krb5-config ldap-utils \
        oddjob oddjob-mkhomedir \
        dnsutils iproute2 iputils-ping procps net-tools ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# NSS: Ubuntu's libnss-sss does NOT edit nsswitch.conf (that is authselect's
# job on RH). Without this, sssd runs, authenticates, and yet `id rdpuser`
# still says "no such user" — PAM account stage then fails and the login is
# rejected with no useful message anywhere.
RUN for db in passwd group shadow services netgroup sudoers; do \
      grep -qE "^$db:.*\bsss\b" /etc/nsswitch.conf \
        || sed -i -E "s/^($db:[^#]*)$/\1 sss/" /etc/nsswitch.conf; \
    done \
 && grep -E '^(passwd|group|shadow):' /etc/nsswitch.conf

# PAM: pam_sss into the common-* stacks, and mkhomedir so a domain user who has
# never logged in anywhere gets a home directory. XFCE will not start without a
# writable HOME.
RUN pam-auth-update --enable sss --enable mkhomedir --force \
 && grep -c pam_sss.so /etc/pam.d/common-auth

# TLS material. Generated at build time so the negotiated security layer is
# deterministic rather than depending on whether the postinst hook ran.
RUN openssl req -x509 -newkey rsa:2048 -nodes -days 3650 \
        -keyout /etc/xrdp/key.pem -out /etc/xrdp/cert.pem \
        -subj "/C=US/O=edt1 lab/CN=rdp-target" 2>/dev/null \
 && chown root:xrdp /etc/xrdp/key.pem /etc/xrdp/cert.pem \
 && chmod 640 /etc/xrdp/key.pem && chmod 644 /etc/xrdp/cert.pem

# xrdp.ini: force TLS material, and autorun the Xvnc module so a client that
# supplies /u and /p never sees the session-type dropdown and logs straight in.
RUN set -e; ini=/etc/xrdp/xrdp.ini; \
    setg() { \
      if grep -qE "^#?$1=" "$ini"; then sed -i -E "s|^#?$1=.*|$1=$2|" "$ini"; \
      else sed -i "0,/^\[Globals\]/s//[Globals]\n$1=$2/" "$ini"; fi; }; \
    setg security_layer negotiate; \
    setg crypt_level high; \
    setg certificate /etc/xrdp/cert.pem; \
    setg key_file /etc/xrdp/key.pem; \
    setg autorun Xvnc; \
    setg tls_ciphers HIGH; \
    setg new_cursors true; \
    grep -E '^(port|security_layer|crypt_level|certificate|key_file|autorun)=' "$ini"

# The session: plain xfce4-session under a private dbus. Ubuntu's stock
# startwm.sh defers to Xsession, which in a container with no display manager
# picks nothing and exits immediately.
#
# Everything is teed into ~/.xrdp-session.log. xrdp does NOT preserve the
# window manager's stderr anywhere: a session that dies leaves only
# "Window manager exited with signal SIGABRT" in sesman.log, which names the
# signal and nothing else.
RUN printf '%s\n' \
    '#!/bin/sh' \
    '# xrdp session start — runs as the authenticated user.' \
    'exec >>"$HOME/.xrdp-session.log" 2>&1' \
    'echo "=== $(date -Is) session start: user=$(id -un) display=$DISPLAY ==="' \
    'unset DBUS_SESSION_BUS_ADDRESS XDG_RUNTIME_DIR' \
    'export XDG_SESSION_TYPE=x11 XDG_CURRENT_DESKTOP=XFCE NO_AT_BRIDGE=1' \
    'exec dbus-launch --exit-with-session xfce4-session' \
    > /etc/xrdp/startwm.sh && chmod 0755 /etc/xrdp/startwm.sh

# A terminal on every login. This is a lab target whose whole purpose is to be
# driven remotely, and an automated test needs one guaranteed keyboard-input
# target: XFCE ships no application launcher that can be reached by a key
# sequence without xfce4-settings' shortcut daemon, and driving xfdesktop's
# right-click menu by pixel coordinates is not a test, it is a coin flip.
RUN printf '%s\n' \
    '[Desktop Entry]' \
    'Type=Application' \
    'Name=Lab RDP console' \
    'Comment=Guaranteed keyboard target for automated RDP tests' \
    'Exec=xfce4-terminal --title=RDP-LAB-CONSOLE --geometry=100x26+40+40 --working-directory=/tmp' \
    'X-GNOME-Autostart-enabled=true' \
    'OnlyShowIn=XFCE;' \
    > /etc/xdg/autostart/zz-lab-rdp-console.desktop

COPY edy-domain-install.sh /usr/local/sbin/edy-domain-install
COPY rdp/rdp-entrypoint.sh /usr/local/sbin/rdp-entrypoint.sh
RUN chmod 0755 /usr/local/sbin/edy-domain-install /usr/local/sbin/rdp-entrypoint.sh

EXPOSE 3389/tcp
ENTRYPOINT ["/usr/local/sbin/rdp-entrypoint.sh"]
