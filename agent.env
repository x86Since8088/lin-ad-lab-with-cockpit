# edy-proxy-go agent integration — single source of truth. Sourced by
# 40-agent.sh and 45-agent-verify.sh; edit here only.
# Inherits lab identity from lab.env and the RDP roster from rdp/rdp.env.

_agent_here="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
# rdp.env sources ../lab.env itself, so one line pulls in both rosters.
. "$_agent_here/rdp/rdp.env"

# The controller (edy-proxy-go) runs on the HOST. Containers reach it through
# their gateway, but NOT at that gateway address: 172.15.4.1 is not in the
# server's listen_ips — 172.16.4.1 (br-lab-edt) is, and the kernel delivers it
# locally from the lab subnet. HTTPS on 8444 carries the same API as HTTP on
# 8080, its leaf cert has an IP SAN for 172.16.4.1, and it chains to the EDY
# Proxy Root CA — so agents get full TLS verification once that CA is
# anchored, and enrollment needs only a leaf-fingerprint pin, never
# --insecure (which would silently disable self-update).
EDY_SERVER_URL="https://172.16.4.1:8444"    # what agents inside containers use
EDY_ADMIN_API="http://127.0.0.1:8080"       # host-local, for admin/token ops

# Root-only admin credential for minting invitation tokens. Parsed fresh on
# every use; the values must never reach argv, the environment, or a log.
EDY_CRED_FILE="/opt/sc/edy-local/bin/admin_credentials.txt"

# The controller's own release staging area — the exact bytes it serves to
# self-updating agents.
EDY_AGENT_BIN="/opt/sc/edy-local/storage/agent-dist/edy-agent-linux-amd64"

# Anchor path INSIDE containers. This is the exact file `edy-agent catrust`
# manages on Debian/Ubuntu (debianAnchorDir/debianAnchorFile), so its
# uninstall remains usable against anchors we placed.
EDY_CA_ANCHOR="/usr/local/share/ca-certificates/edy-proxy-ca.crt"

# Pinned per-container agent GUIDs — see the header of that file.
AGENT_GUID_FILE="$_agent_here/agent-guids.txt"

# Every lab container, in lifecycle order. 30-verify.sh predates the RDP
# targets and covers only DCs+clients; agent coverage is all seventeen.
all_lab_containers() {
    local i
    for i in $(seq 1 "$DC_COUNT"); do dc_name "$i"; done
    for i in $(seq 1 "$CLIENT_COUNT"); do client_name "$i"; done
    for i in $(seq 1 "$RDP_COUNT"); do rdp_name "$i"; done
}

ctr_up() { podman inspect -f '{{.State.Running}}' "$1" 2>/dev/null | grep -qx true; }

# Read the admin credential and run curl with it. The credential travels via
# curl's -K config on stdin — never argv (host `ps` is world-readable).
_edy_admin_curl() {   # usage: _edy_admin_curl <curl args...>
    local u p
    u=$(grep -iE '^username' "$EDY_CRED_FILE" | head -1 \
        | sed -E 's/^[^:=]+[:=][[:space:]]*//' | tr -d '\r\n')
    p=$(grep -iE '^password' "$EDY_CRED_FILE" | head -1 \
        | sed -E 's/^[^:=]+[:=][[:space:]]*//' | tr -d '\r\n')
    curl -s -K - "$@" <<< "user = \"$u:$p\""
}

# Mint a single-use enrollment invitation (1h TTL). Prints the token on
# stdout and nowhere else — callers must keep it off argv and out of logs.
mint_token() {
    _edy_admin_curl -X POST "$EDY_ADMIN_API/api/agents/invitations" \
        -H 'Content-Type: application/json' \
        -d '{"permissions":["tcp","dns","arp"],"expires_in":1}' \
      | python3 -c 'import json,sys; print(json.load(sys.stdin)["token"])'
}

# Current CA certificate PEM -> $1. GET /api/ca is unauthenticated by design.
fetch_ca() {
    curl -s "$EDY_ADMIN_API/api/ca" \
      | python3 -c 'import json,sys; sys.stdout.write(json.load(sys.stdin)["certificate_pem"])' \
      > "$1"
    grep -q 'BEGIN CERTIFICATE' "$1"
}

# The controller's current TLS leaf fingerprint, for pinning the enroll
# handshake. Queried live, never hardcoded: the listener cert rotates.
server_fp() {
    curl -s "$EDY_ADMIN_API/api/cert-pinning" \
      | python3 -c 'import json,sys; print(json.load(sys.stdin)["signed_data"]["current_fingerprint"])'
}

# Stable GUID for a container name; generates and records one on first use.
agent_guid() {
    local n="$1" g
    g=$(awk -v n="$n" '$1==n{print $2}' "$AGENT_GUID_FILE" 2>/dev/null | head -1)
    if [[ -z "$g" ]]; then
        g=$(python3 -c 'import uuid; print(uuid.uuid4())')
        printf '%s %s\n' "$n" "$g" >> "$AGENT_GUID_FILE"
    fi
    echo "$g"
}
