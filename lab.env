# Samba AD DC lab — single source of truth. Scripts source this; edit here only.
LAB_VERSION="1.0.0.20260901"   # branded release version

# --- identity ---------------------------------------------------------------
REALM="AD.EDT1.LAB"          # Kerberos realm, ALWAYS uppercase
DOMAIN_DNS="ad.edt1.lab"     # DNS domain, lowercase
DOMAIN_NB="EDT1LAB"          # NetBIOS name, <=15 chars, uppercase, no dots

# --- scale ------------------------------------------------------------------
# Acceptance gate: the installer must pass at this scale before the physical
# host is permitted to join anything.
DC_COUNT=5
CLIENT_COUNT=10

# --- network (static-edt, 172.15.4.0/24) ------------------------------------
NET="static-edt"
NET_PREFIX="172.15.4"
DC_BASE=10                   # dc1..dc5   -> .10 .11 .12 .13 .14
CLIENT_BASE=20               # client1..client10 -> .20 ... .29
FORWARDER="172.16.4.1"       # upstream DNS for non-domain queries: edy-proxy-go
                             # on the host (goal 2026-09-01: DNS backed by edy;
                             # AD-integrated zones stay on the DCs). Applied in
                             # smb.conf at samba START — a forwarder edit needs
                             # a rolling `podman restart`, reload-config is not
                             # enough. Wire-proven with tcpdump dcN<->172.16.4.1.

# derived helpers -----------------------------------------------------------
dc_name()     { echo "dc$1"; }
dc_ip()       { echo "${NET_PREFIX}.$((DC_BASE + $1 - 1))"; }
client_name() { echo "client$1"; }
client_ip()   { echo "${NET_PREFIX}.$((CLIENT_BASE + $1 - 1))"; }

# --- images -----------------------------------------------------------------
IMG_DC="localhost/samba-ad-dc:latest"
IMG_CLIENT="localhost/ad-client:latest"

# --- secrets ----------------------------------------------------------------
# Lab credential for a throwaway domain, generated once, root-only, never echoed.
#
# SECRET_DIR is DERIVED from this file's own location and is never a hardcoded
# absolute path. A repo that names its own checkout location is what produced
# the breakage this rule exists for: the checkout moved, this line did not, and
# every script that ran `install -d "$SECRET_DIR"` then minted an empty 0700
# directory at a dead path while the real credentials sat somewhere else.
# (The dead path is not written here on purpose -- this file is INSTALLED to
# /etc/samba-ad-lab/lab.env, and install.sh refuses any installed file that
# names a retired or development root, comments included.)
#
# lab.env lives at <project>/source/lab.env and the secrets live at
# <project>/.secrets — one level up, deliberately outside the tracked tree.
#
# install.sh replaces EVERYTHING between the two markers below with an explicit
# absolute path when it installs lab.env to /etc/samba-ad-lab/lab.env: an
# installed copy has no <project>/.secrets neighbour and must not guess one
# (the derivation would compute /etc/.secrets). Do not remove the markers and
# do not put anything else between them — install.sh refuses without them.
# >>> SECRET_DIR
SECRET_DIR="$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)/.secrets"
# <<< SECRET_DIR
ADMIN_PASS_FILE="$SECRET_DIR/administrator.pass"

# --- persistent state (goal 2026-09-01) -------------------------------------
# DC and client state lives on the HOST so it survives RECREATION (podman rm +
# run / 20-up.sh), not merely restart. Before this, there were no state
# volumes: a recreate wiped /var/lib/samba and silently re-provisioned a BRAND
# NEW forest. Now each container bind-mounts its state from $STATE_ROOT.
#
# Bind mounts, not named volumes: visible, backup-able, and — crucially —
# /opt/sc supports security.* xattrs, which samba's SYSVOL NTACLs require
# (a volume on a store that drops them silently reproduces the empty-SYSVOL /
# BUILTIN\Guests-ACL incidents). Bind mounts also SHADOW rather than copy-up,
# so a fresh (empty) state dir means "not provisioned yet" and the entrypoint
# provisions into it; a populated one means "already a DC" and it just starts.
STATE_ROOT="/opt/sc/lab-state"

# Emit `-v` flags for a DC's persistent state, creating the host dirs first.
# /var/lib/samba carries the whole forest: sam.ldb, private/tls (the EDY-issued
# LDAPS certs), sysvol, and the per-DC non-replicated idmap.ldb.
dc_state_args() {   # $1 = dc index
    local d="$STATE_ROOT/$(dc_name "$1")"
    install -d -m 0755 "$d/var-lib-samba" "$d/etc-samba" "$d/edy-agent"
    printf ' -v %s:/var/lib/samba -v %s:/etc/samba -v %s:/etc/edy-agent' \
        "$d/var-lib-samba" "$d/etc-samba" "$d/edy-agent"
}

# Emit `-v` flags for a client's persistent state. The machine keytab is a
# single file, so it is a file bind-mount (pre-created empty so podman does not
# make a directory); the domain join writes the credential through it.
client_state_args() {   # $1 = client index
    local d="$STATE_ROOT/$(client_name "$1")"
    install -d -m 0755 "$d/etc-sssd" "$d/var-lib-sss" "$d/edy-agent"
    [ -e "$d/krb5.keytab" ] || : > "$d/krb5.keytab"
    printf ' -v %s:/etc/sssd -v %s:/var/lib/sss -v %s:/etc/edy-agent -v %s:/etc/krb5.keytab' \
        "$d/etc-sssd" "$d/var-lib-sss" "$d/edy-agent" "$d/krb5.keytab"
}

# Point a client/RDP container's resolver at an AD DC. podman rewrites
# /etc/resolv.conf to the aardvark gateway on every (re)start, which knows
# nothing about the AD zone — so a recreated, already-joined client must be
# pointed back at a DC (then the edy forwarder) or every SRV lookup NXDOMAINs.
# DCs self-heal this in dc-entrypoint; clients/RDP do not.
fix_ad_resolv() {   # $1 = container, $2 = DC ip to use first
    podman exec "$1" bash -c "{ echo 'search ${REALM,,}'
                                echo 'nameserver $2'
                                echo 'nameserver $FORWARDER'; } > /etc/resolv.conf"
}

# --- safety -----------------------------------------------------------------
# The physical host must NOT be joined until the gate above passes.
ALLOW_HOST_JOIN="no"
