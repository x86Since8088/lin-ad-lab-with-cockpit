# ha-testbed: two throwaway Ubuntu VMs standing in for edt1 (A) and mini-srv (B).
# Design: docs/design/HA-MULTI-HOST.md §10. NO secrets in this file.
# Isolation rule (owner 2026-11-11): the testbed runs its OWN edy-proxy-go deployment and never
# integrates with edt1's: no registration with the edt1 hub, no use of its DNS/DHCP/NTP/CA.
TB_NET=adl-ha                 # libvirt network: isolated L2, NO host address, no forward, no dnsmasq
TB_BRIDGE=virbr-adlha
TB_IMG_DIR=/var/lib/libvirt/images/adl-ha
TB_BASE=/var/lib/libvirt/images/base/noble-server-cloudimg-amd64.img   # stock Ubuntu 24.04 cloud image
TB_STATE=${TB_STATE:-$HOME/.local/state/adl-ha}   # rendered seeds (no secrets; password HASH only)
TB_SECRETS=${TB_SECRETS:-$HOME/.config/adl-ha}    # 0700: eddie.pass (cockpit/sudo login), never in git
TB_DNS="9.9.9.9 1.1.1.1"      # public resolvers: NOT edt1's edy DNS
TB_NTP="ntp.ubuntu.com"       # NOT edt1's chrony / edy time
TB_DOMAIN=adlha.test

# lab0 = the home LAN 192.168.2.0/24 on edt1's bridge0 (owner 2026-11-11): ssh, cockpit, apt egress via the BGW320.
# Static, below the BGW DHCP leases (.64+); .1-.10 reserved by the host plan; .14 edt1, .15/.16 router VIPs.
# .41/.42 were free (ping + neigh) on 2026-11-11; tb.sh create re-checks. No port forwards to them.
TB_LAN_BRIDGE=bridge0
TB_LAN_GW=192.168.2.254
# name      vcpus mem_mb disk_gb lab0_ip (LAN)  ha0_ip (adl-ha)  mac prefix
TB_VMS=(
  "adl-ha-a 4 8192 40 192.168.2.41 10.31.0.11 52:54:00:ad:01"
  "adl-ha-b 4 8192 40 192.168.2.42 10.31.0.12 52:54:00:ad:02"
)
# Three networks per VM (owner 2026-11-11: "each need an isolated subnet and a HA subnet"):
#  1. lan0  192.168.2.0/24  (above)
#  2. ISOLATED subnet, one per VM, host-local: a podman bridge INSIDE the VM (like static-edt on edt1).
#     That host's DCs and test clients live here, pinned to the host. Never stretched; reached from the
#     other VM only by a route over ha0.
TB_ISO_NET=adl-iso
TB_ISO_SUBNET_adl_ha_a=172.31.4.0/24
TB_ISO_SUBNET_adl_ha_b=172.31.5.0/24
#  3. HA subnet 10.31.0.0/24 on libvirt net adl-ha (TB_NET), shared by both VMs: each VM a unique IP
#     (TB_VMS ha0_ip) plus reserved floating/anycast VIPs for single-writer and anycast services
#     (design §5/§6.2). Carries inter-host replication and the iso-subnet routes.
TB_HA_SUBNET=10.31.0.0/24
TB_HA_VIP_DNS=10.31.0.53      # anycast DNS VIP (health-gated, both hosts)
TB_HA_VIP_WRITER=10.31.0.100  # floating VIP of the SYSVOL/GPO writer (lease holder only)

tb_vm() {   # NAME -> sets VM CPUS MEM DISK LAB_IP HA_IP MACP; 1 if NAME is not a testbed VM
  local want=$1 l f; for l in "${TB_VMS[@]}"; do read -r -a f <<<"$l"
    [ "${f[0]}" = "$want" ] && { VM=${f[0]} CPUS=${f[1]} MEM=${f[2]} DISK=${f[3]} LAB_IP=${f[4]} HA_IP=${f[5]} MACP=${f[6]}; return 0; }; done
  return 1; }
