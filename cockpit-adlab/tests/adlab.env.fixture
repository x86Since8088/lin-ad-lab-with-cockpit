# Test fixture: a .env in the DEPLOY-CONTRACT section 4.1 grammar.
#
# This is NOT a deployed .env and it is NOT read by anything on a host. It exists
# so the verb tests can describe a CONFIGURED host without needing one, through
# the single tests-only route the contract allows ($ADLAB_ENV, honoured for a
# non-root process whose uid owns the file). The values are deliberately obvious
# fakes: if one of them ever shows up in a command a verb built, a test failure
# should say so loudly.
ADLAB_ROOT=/test/samba-ad-lab
ADLAB_LAB_ENV=/test/samba-ad-lab/lab.env
ADLAB_RDP_ENV=/test/samba-ad-lab/rdp.env
ADLAB_SYSVOL_REPLICATE=/test/libexec/sysvol-replicate.sh
ADLAB_SECRET_DIR=/test/secrets
ADLAB_GPO_TEMPLATE_DIR=/test/gpo-templates
