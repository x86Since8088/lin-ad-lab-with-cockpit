def v_sites_list(a):
    d = first_up_dc()
    base = "CN=Sites,CN=Configuration," + domain_dn()
    rc, out, err = podman(d, ["ldbsearch", "-H", SAM, "-b", base,
                              "(objectClass=site)", "name"])
    if rc != 0:
        raise Fail(err.strip() or out.strip())
    sites = [e.get("name", ["?"])[0] for e in parse_ldif_entries(out)
             if "name" in e]
    rc2, out2, _ = podman(d, ["ldbsearch", "-H", SAM, "-b", base,
                              "(objectClass=subnet)", "name", "siteObject"])
    subnets = []
    if rc2 == 0:
        for e in parse_ldif_entries(out2):
            if "name" in e:
                subnets.append({"subnet": e["name"][0],
                                "site": (e.get("siteObject", [""])[0]
                                         .split(",")[0].replace("CN=", ""))})
    return {"sites": sorted(sites), "subnets": subnets}

def v_repl_status(a):
    targets = [a["dc"]] if a.get("dc") else all_dcs()
    result = []
    for d in targets:
        if ctr_state(d) != "running":
            result.append({"dc": d, "error": "not running"})
            continue
        rc, out, err = podman(d, ["samba-tool", "drs", "showrepl"])
        if rc != 0:
            result.append({"dc": d, "error": err.strip() or out.strip()})
        else:
            rep = parse_showrepl(out)
            result.append({"dc": d, "neighbors": rep["neighbors"]})
    return {"replication": result}

def v_repl_now(a):
    """Trigger KCC + a full replication cycle on one DC (or all)."""
    targets = [a["dc"]] if a.get("dc") else all_dcs()
    done = []
    for d in targets:
        if ctr_state(d) != "running":
            done.append({"dc": d, "error": "not running"})
            continue
        rc, out, err = podman(d, ["samba-tool", "drs", "kcc"])
        done.append({"dc": d, "kcc": "ok" if rc == 0 else (err.strip() or out.strip())})
    return {"triggered": done}

def v_sysvol_status(a):
    rows = []
    script = ('find /var/lib/samba/sysvol -type f -exec sha256sum {} \\; '
              '2>/dev/null | sed "s| .*/sysvol/| |" | sort | sha256sum | cut -c1-16')
    for d in all_dcs():
        if ctr_state(d) != "running":
            rows.append({"dc": d, "error": "not running"})
            continue
        rc, h, _ = podman(d, ["bash", "-c", script])
        rc2, n, _ = podman(d, ["bash", "-c",
                               "find /var/lib/samba/sysvol -type f | wc -l"])
        rows.append({"dc": d, "hash": h.strip(), "files": int(n.strip() or 0)})
    hashes = set(r.get("hash") for r in rows if "hash" in r)
    return {"dcs": rows, "identical": len(hashes) == 1}

