# --------------------------------------------------------------------------
# argument parsing, validation, audit, main
# --------------------------------------------------------------------------

def parse_args(spec, argv):
    """--name value pairs -> validated dict. Pure; raises Fail."""
    given = {}
    i = 0
    while i < len(argv):
        if not argv[i].startswith("--"):
            raise Fail("expected --arg, got %r" % argv[i])
        key = argv[i][2:]
        if i + 1 >= len(argv):
            raise Fail("missing value for --%s" % key)
        given[key] = argv[i + 1]
        i += 2
    out = {}
    for a in spec.get("args", []):
        name, typ = a["name"], a["type"]
        if typ == "password-stdin":
            continue                      # travels on stdin, never argv
        if name in given:
            v = given.pop(name)
            if typ == "int":
                try:
                    v = int(v)
                except ValueError:
                    raise Fail("--%s must be an integer" % name)
            if typ == "enum" and a.get("choices") and v not in a["choices"]:
                raise Fail("--%s must be one of: %s"
                           % (name, ", ".join(a["choices"])))
            out[name] = v
        elif a.get("required"):
            raise Fail("missing required --%s" % name)
        elif "default" in a:
            out[name] = a["default"]
    if given:
        raise Fail("unknown argument(s): %s"
                   % ", ".join("--" + k for k in given))
    return out

def audit(verb, args, ok):
    """Append one line per invocation. Argument VALUES are logged except for
    password-typed args (never present in args anyway); errors are not."""
    try:
        line = "%s %s %s %s\n" % (
            time.strftime("%Y-%m-%dT%H:%M:%S%z"), "OK " if ok else "ERR",
            verb, json.dumps(args, sort_keys=True))
        with open(AUDIT_LOG, "a") as f:
            f.write(line)
        os.chmod(AUDIT_LOG, 0o600)
    except OSError:
        pass

def _extract_domain(argv):
    # `--domain <realm>` is a GLOBAL selector, valid before or after the verb:
    # it sets which forest the verb acts on. Pop it so per-verb parse_args never
    # sees it. Returns (argv_without_domain, realm_or_None).
    out, realm, i = [], None, 0
    while i < len(argv):
        if argv[i] == "--domain" and i + 1 < len(argv):
            realm = argv[i + 1]
            i += 2
            continue
        out.append(argv[i])
        i += 1
    return out, realm


def main(argv):
    global CUR, LAB
    argv, _dom_sel = _extract_domain(argv)
    try:
        CUR = resolve_domain(_dom_sel)   # default: primary (unchanged behavior)
        LAB = CUR                        # every LAB["..."] read is now current-domain
    except Fail as e:
        print(json.dumps({"error": str(e)}))
        return 2
    if len(argv) < 1 or argv[0] in ("-h", "--help"):
        print(json.dumps({"error": "usage: adlab-admin [--domain REALM] VERB [--arg value ...]",
                          "verbs": sorted(VERBS)}))
        return 2
    verb = argv[0]
    spec = VERBS.get(verb)
    if not spec:
        print(json.dumps({"error": "unknown verb %r" % verb,
                          "verbs": sorted(VERBS)}))
        return 2
    # A --dc / --to_dc enum reflects the CURRENT domain's DCs (dynamic per
    # --domain), so a DC in a non-primary forest is accepted while an invalid
    # one is still rejected with "must be one of". The module VERBS spec (which
    # v_schema dumps) is left untouched.
    if spec.get("args") and any(
            ar.get("type") == "enum" and ar.get("name") in ("dc", "to_dc")
            for ar in spec["args"]):
        cur_dcs = all_dcs()
        spec = dict(spec, args=[
            (dict(ar, choices=cur_dcs)
             if ar.get("type") == "enum" and ar.get("name") in ("dc", "to_dc")
             else ar)
            for ar in spec["args"]])
    try:
        args = parse_args(spec, argv[1:])
    except Fail as e:
        print(json.dumps({"error": str(e)}))
        return 2
    try:
        # Meta verbs (schema/version/config) work with no lab so an operator can
        # always introspect and diagnose; every other verb needs the resolved
        # configuration and fails loudly, naming install.conf, without it.
        if spec.get("group") != "meta":
            _require_config()
        result = spec["fn"](args)
        audit(verb, args, True)
        print(json.dumps(result))
        return 0
    except Fail as e:
        audit(verb, args, False)
        print(json.dumps({"error": str(e)}))
        return 1
    except Exception as e:            # noqa: BLE001 — contract: JSON always
        audit(verb, args, False)
        print(json.dumps({"error": "internal: %s" % e}))
        sys.stderr.write("adlab-admin internal error on %s: %r\n" % (verb, e))
        return 3

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
