# ---- GPO settings: Administrative Templates / registry.pol ----------------
# The three layers the compose modal stacks:
#   1. template GPOs  -> gpo-registry-list a source, feed its entries here
#   2. ADMX templates -> gpo-admxload + pick a policy -> registry entries
#   3. preferences    -> gpo-pref-set (the samba `gpo manage <cse>` CSEs)
# All Administrative-Template settings compile to registry.pol entries applied
# with `samba-tool gpo load` (a JSON array on stdin).

# GPO_TEMPLATE_DIR is resolved at the top from the .env's ADLAB_GPO_TEMPLATE_DIR
# (default /var/lib/samba/gpo-templates — a bind mount inside a DC container, so
# saved templates survive a container recreate).
DEFAULT_REG_CSE = "{35378EAC-683F-11D2-A89A-00C04FBBCFA2}"  # registry policy
REG_CLASSES = ["MACHINE", "USER", "BOTH"]
GPO_CSES = ["smb_conf", "security", "motd", "issue", "sudoers", "files",
            "symlink", "openssh", "scripts", "access"]

# ---- settings catalog: OS type + subsystem facets -------------------------
# Every available setting is tagged with an OS type and a set of subsystems so
# the editor's left pane can browse ALL available settings by facet. Defaults
# are derived from the setting's source (ADMX file / CSE); the operator can
# override them, persisted in a host-side tags file.
OS_TYPES = ["Windows", "Linux"]
SUBSYSTEMS = ["WinPC", "WinServer", "gnome", "kde", "debian", "redhat",
              "ubuntu", "wayland", "vnc", "xfreerdp3", "other"]
CATALOG_TAGS_FILE = "/var/lib/adlab/catalog-tags.json"   # host, root-only

def _derive_tags(source, ref):
    """Default (os_type, subsystems) for a catalog entry. source is
    'admx' | 'cse'; ref is the ADMX filename or the CSE name."""
    r = (ref or "").lower()
    if source == "admx":
        # adsys (Ubuntu's AD GPO client) ships Ubuntu.admx in namespace
        # Canonical.Policies.Ubuntu; without this branch it hit the Windows
        # default below, so every Linux client-policy setting was mis-tagged
        # Windows and hidden from the editor's Linux facet.
        if "ubuntu" in r or "adsys" in r or "canonical" in r:
            return "Linux", ["ubuntu", "gnome", "debian"]
        if "gnome" in r:  return "Linux", ["gnome", "kde", "wayland"]
        if "samba" in r:  return "Linux", ["debian", "ubuntu", "redhat"]
        return "Windows", ["WinPC", "WinServer"]
    if source == "cse":
        table = {"smb_conf": ["debian", "ubuntu", "redhat"],
                 "security": ["debian", "ubuntu", "redhat"],
                 "sudoers":  ["debian", "redhat", "ubuntu"],
                 "motd":     ["debian", "ubuntu", "redhat"],
                 "issue":    ["debian", "ubuntu", "redhat"],
                 "openssh":  ["debian", "redhat", "ubuntu"],
                 "files":    ["debian", "ubuntu"], "symlink": ["debian", "ubuntu"],
                 "scripts":  ["debian", "ubuntu"], "access": ["debian", "ubuntu"]}
        return "Linux", table.get(r, ["other"])
    return "Linux", ["other"]

def _read_catalog_tags():
    try:
        with open(CATALOG_TAGS_FILE) as f:
            t = json.load(f)
            return t if isinstance(t, dict) else {}
    except (OSError, ValueError):
        return {}

def _write_catalog_tags(tags):
    os.makedirs(os.path.dirname(CATALOG_TAGS_FILE), exist_ok=True)
    with open(CATALOG_TAGS_FILE, "w") as f:
        json.dump(tags, f, indent=2, sort_keys=True)
    os.chmod(CATALOG_TAGS_FILE, 0o600)

# ---- persistent ADMX catalog cache ----------------------------------------
# Parsing the whole ADMX central store is a per-file `podman exec` read for
# every .admx/.adml -- thousands of policies, tens of seconds -- and the editor
# paid it on every open. The cache stores each ADMX file's PARSED policies keyed
# by a 'size:mtime' signature, so a refresh re-reads only files newer than the
# cache (differential), purges entries whose ADMX no longer exists (delete
# detection), and keeps the rest. OS/subsystem facets + operator tag overrides
# are applied at SERVE time, not cached, so retagging never needs a re-parse.
CATALOG_CACHE_FILE = "/var/lib/adlab/catalog-cache.json"   # host, world-readable
CATALOG_CACHE_VERSION = 1                                  # bump to invalidate


def _now_iso():
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def _read_catalog_cache():
    try:
        with open(CATALOG_CACHE_FILE) as f:
            c = json.load(f)
            return c if isinstance(c, dict) else {}
    except (OSError, ValueError):
        return {}


def _write_catalog_cache(cache):
    # 0644 in a world-readable dir ON PURPOSE: the browser subscribes to a
    # Cockpit fswatch on this file to learn when the catalog refreshed, and the
    # session user (not root) must be able to watch it. It holds only ADMX policy
    # metadata, no secrets. Atomic replace: a watcher never sees a half file, and
    # the mtime bump IS the refresh event the browser reacts to.
    d = os.path.dirname(CATALOG_CACHE_FILE)
    os.makedirs(d, exist_ok=True)
    try:
        os.chmod(d, 0o755)
    except OSError:
        pass
    tmp = CATALOG_CACHE_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(cache, f)
    os.chmod(tmp, 0o644)
    os.replace(tmp, CATALOG_CACHE_FILE)


def _admx_signatures(dc, root, lang):
    """One exec: every ADMX (and the lang's ADML) in the central store with a
    'size:mtime' signature. Returns (admx_sigs, adml_by_lower):
      admx_sigs     = {admx_path: "size:mtime"}
      adml_by_lower = {adml_basename_lower: (adml_path, "size:mtime")}"""
    pd = "%s/PolicyDefinitions" % root
    cmd = (r"find %s -maxdepth 2 \( -iname '*.admx' -o -iname '*.adml' \) "
           r"-printf '%%p\t%%s\t%%T@\n' 2>/dev/null" % shq(pd))
    rc, out, _ = podman(dc, ["bash", "-c", cmd])
    admx, adml = {}, {}
    lang_seg = ("/%s/" % lang).lower()
    for line in (out or "").splitlines():
        parts = line.split("\t")
        if len(parts) != 3:
            continue
        path, size, mtime = parts
        sig = "%s:%s" % (size, mtime)
        low = path.lower()
        if low.endswith(".admx"):
            admx[path] = sig
        elif low.endswith(".adml") and lang_seg in low:
            adml[path.rsplit("/", 1)[-1].lower()] = (path, sig)
    return admx, adml


def _adml_for(admx_path, adml_by_lower):
    return adml_by_lower.get((admx_path.rsplit("/", 1)[-1][:-5] + ".adml").lower())


def _catalog_diff(cached_admx, cur_admx_sigs, adml_by_lower, force=False):
    """PURE: decide per-ADMX-file actions for a differential refresh. Returns
    (to_parse, reused, deleted):
      to_parse = [(admx_path, adml_path_or_None, admx_sig, adml_sig)]  -- (re)ingest
      reused   = [admx_path ...]   unchanged; keep the cached policies
      deleted  = [admx_path ...]   in the cache but no longer backed -> purge"""
    deleted = [p for p in cached_admx if p not in cur_admx_sigs]
    to_parse, reused = [], []
    for path, sig in cur_admx_sigs.items():
        adml = _adml_for(path, adml_by_lower)
        adml_sig = adml[1] if adml else ""
        cur = cached_admx.get(path)
        if (not force) and cur and cur.get("sig") == sig and cur.get("adml_sig") == adml_sig:
            reused.append(path)
        else:
            to_parse.append((path, adml[0] if adml else None, sig, adml_sig))
    return to_parse, reused, deleted


def _parse_one_admx(dc, admx_path, adml_path):
    """Parse ONE ADMX file's policies, names resolved against its ADML."""
    xml = _read_b64(dc, admx_path)
    if xml is None:
        return []
    name = admx_path.rsplit("/", 1)[-1]
    adml = _read_b64(dc, adml_path) if adml_path else None
    strings = parse_adml(adml) if adml else {}
    out = []
    for p in parse_admx(xml):
        p["admx"] = name
        p["display"] = _resolve_ref(p.get("display", ""), strings) or p.get("id", "")
        p["explain"] = _resolve_ref(p.get("explain", ""), strings)
        disp = p["display"]
        p["unresolved"] = (not disp) or disp.startswith("string.") \
            or bool(re.match(r'^POL_[0-9A-Fa-f_]+$', disp))
        out.append(p)
    return out


def _refresh_catalog_cache(force=False):
    """Differentially refresh the persistent ADMX catalog cache. Stats the central
    store once, re-parses only ADMX whose file (or its ADML) changed, purges
    entries whose ADMX no longer exists, keeps the rest. Rewrites the cache file
    ONLY when something changed, so a Cockpit fswatch fires only on real change.
    Returns (cache, changed, stats)."""
    dc = pdc_emulator()
    root = _pol_root(dc)
    lang = "en-US"
    admx_sigs, adml_by_lower = _admx_signatures(dc, root, lang)
    cache = _read_catalog_cache()
    if (cache.get("version") != CATALOG_CACHE_VERSION or cache.get("pol_root") != root
            or cache.get("lang") != lang or "admx" not in cache):
        cache = {"version": CATALOG_CACHE_VERSION, "pol_root": root, "lang": lang, "admx": {}}
        force = True
    admx = cache["admx"]
    to_parse, reused, deleted = _catalog_diff(admx, admx_sigs, adml_by_lower, force)
    for p in deleted:
        admx.pop(p, None)
    for path, adml_path, sig, adml_sig in to_parse:
        admx[path] = {"sig": sig, "adml_sig": adml_sig,
                      "policies": _parse_one_admx(dc, path, adml_path)}
    changed = bool(to_parse or deleted)
    if changed:
        cache["built"] = _now_iso()
        cache["on"] = dc
        _write_catalog_cache(cache)
    return cache, changed, {"reparsed": len(to_parse), "reused": len(reused),
                            "deleted": len(deleted)}


def _catalog_policies_from_cache(cache):
    pols = []
    for _path, e in sorted((cache.get("admx") or {}).items()):
        pols.extend(e.get("policies", []))
    return pols

def _gpo_guid(a, key="gpo"):
    g = a[key].strip()
    if not re.match(r'^\{[0-9A-Fa-f-]{36}\}$', g):
        raise Fail("%s must be a GPO GUID like {31B2F340-...}" % key)
    return g

def _sysvol_gpo_dir(gpo):
    return "/var/lib/samba/sysvol/%s/Policies/%s" % (LAB["DOMAIN_DNS"], gpo)

def _read_registry_pol(dc, gpo):
    """Read a GPO's Machine + User registry.pol from sysvol, parse to entries
    tagged with class. Returns [] when the GPO has no registry policy yet."""
    entries = []
    base = _sysvol_gpo_dir(gpo)
    for cls, sub in (("MACHINE", "Machine"), ("USER", "User")):
        # sysvol casing varies; find the .pol case-insensitively
        rc, out, _ = podman(dc, ["bash", "-c",
            "f=$(find %s/%s -maxdepth 1 -iname 'registry.pol' 2>/dev/null | head -1); "
            "[ -n \"$f\" ] && base64 -w0 \"$f\" || true"
            % (shq(base), sub)])
        b64 = (out or "").strip()
        if not b64:
            continue
        try:
            blob = base64.b64decode(b64)
        except Exception:
            continue
        for e in parse_preg(blob):
            e["class"] = cls
            entries.append(e)
    return entries

def v_gpo_registry_list(a):
    d = pdc_emulator()
    gpo = _gpo_guid(a)
    return {"gpo": gpo, "on": d, "settings": _read_registry_pol(d, gpo)}

def _validate_entries(raw):
    try:
        entries = json.loads(raw)
    except Exception as e:
        raise Fail("entries is not valid JSON: %s" % e)
    if not isinstance(entries, list) or not entries:
        raise Fail("entries must be a non-empty JSON array")
    for e in entries:
        for k in ("keyname", "valuename", "class", "type"):
            if k not in e:
                raise Fail("each entry needs keyname/valuename/class/type (%s)" % json.dumps(e)[:80])
        if e["class"].upper() not in REG_CLASSES:
            raise Fail("class must be MACHINE|USER|BOTH, got %r" % e["class"])
        if e["type"] not in REG_TYPES.values():
            raise Fail("type %r not one of %s" % (e["type"], ", ".join(sorted(REG_TYPES.values()))))
        e["class"] = e["class"].upper()
    return entries

def v_gpo_settings_apply(a):
    """Apply Administrative-Template (registry.pol) settings to a GPO via
    `gpo load`. entries = JSON array of {keyname,valuename,class,type,data}."""
    d = pdc_emulator()
    gpo = _gpo_guid(a)
    entries = _validate_entries(a["entries"])
    scope = _declared_gpo_os(gpo)
    _enforce_gpo_scope(scope, entries, gpo)
    cmd = "samba-tool gpo load %s --machine-ext-name=%s --user-ext-name=%s" % (
        shq(gpo), shq(DEFAULT_REG_CSE), shq(DEFAULT_REG_CSE))
    if str(a.get("replace", "")).lower() in ("1", "yes", "true"):
        cmd += " --replace"
    rc, out, err = podman_auth(d, cmd, stdin=json.dumps(entries), timeout=180)
    if rc != 0:
        raise Fail((err.strip() or out.strip())[-600:])
    return {"gpo": gpo, "on": d, "applied": len(entries), "os_scope": scope or "",
            "note": "registry.pol updated; SYSVOL replicates within 5 minutes"}

def v_gpo_settings_remove(a):
    d = pdc_emulator()
    gpo = _gpo_guid(a)
    try:
        entries = json.loads(a["entries"])
    except Exception as e:
        raise Fail("entries is not valid JSON: %s" % e)
    keys = [{"keyname": e["keyname"], "valuename": e["valuename"],
             "class": e["class"].upper()} for e in entries]
    rc, out, err = podman_auth(d, "samba-tool gpo remove " + shq(gpo),
                               stdin=json.dumps(keys), timeout=120)
    if rc != 0:
        raise Fail((err.strip() or out.strip())[-600:])
    return {"gpo": gpo, "on": d, "removed": len(keys)}

# ---- ADMX central store ---------------------------------------------------

def v_gpo_admxload(a):
    d = pdc_emulator()
    rc, out, err = podman_auth(d, "samba-tool gpo admxload", timeout=180)
    if rc != 0:
        raise Fail((err.strip() or out.strip())[-600:])
    # report what landed in the central store
    rc2, ls, _ = podman(d, ["bash", "-c",
        "ls %s 2>/dev/null" % shq("%s/PolicyDefinitions" % _pol_root(d))])
    return {"on": d, "loaded": True,
            "central_store": [x for x in (ls or "").split() if x.endswith(".admx")]}

def _pol_root(dc):
    return "/var/lib/samba/sysvol/%s/Policies" % LAB["DOMAIN_DNS"]

def parse_adml(xml_text):
    """ADML <string id="X">text</string> -> {X: text}. Used to resolve the
    $(string.ID) references in ADMX displayName/explainText into real names."""
    out = {}
    try:
        root = _admx_fromstring(xml_text)
    except ET.ParseError:
        return out
    for s in root.iter():
        if _admx_local(s.tag) == "string" and s.get("id"):
            out[s.get("id")] = "".join(s.itertext()).strip()
    return out

def _resolve_ref(val, strings):
    """'string.POL_x' (an unresolved $(string.ID)) -> its ADML text, else val."""
    if isinstance(val, str) and val.startswith("string."):
        return strings.get(val[len("string."):], val)
    return val

def _read_b64(dc, path):
    rc, b64, _ = podman(dc, ["bash", "-c", "base64 -w0 %s 2>/dev/null" % shq(path)])
    if rc != 0 or not b64.strip():
        return None
    try:
        raw = base64.b64decode(b64.strip())
    except Exception:
        return None
    # Decode by BOM, not by assumption. Microsoft ships at least two templates
    # (Search.admx, Camera.admx) as UTF-16LE; decoding those as UTF-8 yields
    # mojibake that then fails to parse, and the caller's except-and-skip drops
    # the whole file. Search.admx alone is 50 policies that simply never appeared.
    try:
        if raw[:2] in (b"\xff\xfe", b"\xfe\xff"):
            return raw.decode("utf-16")
        if raw[:3] == b"\xef\xbb\xbf":
            return raw.decode("utf-8-sig")
        return raw.decode("utf-8", "replace")
    except Exception:
        return None

def v_gpo_admx_list(a):
    """List ADMX files in the central store and parse their policies, with
    displayName/explainText resolved against the matching ADML (default en-US;
    override with --lang). Each policy carries `unresolved: true` when its name
    is still a raw string.POL_* reference (no ADML text found)."""
    d = pdc_emulator()
    root = "%s/PolicyDefinitions" % _pol_root(d)
    lang = a.get("lang") or "en-US"
    rc, ls, _ = podman(d, ["bash", "-c", "ls %s/*.admx 2>/dev/null" % shq(root)])
    files = [x for x in (ls or "").split() if x.endswith(".admx")]
    # Resolve ADML by case-INSENSITIVE filename. Windows filesystems are case
    # insensitive and Microsoft's own set relies on it: kdc.admx ships alongside
    # KDC.adml, inetres.admx alongside InetRes.adml, messaging.admx alongside
    # Messaging.adml. On SYSVOL (case sensitive) an exact-name lookup misses those
    # three files, and every policy in them renders as string.POL_* and is hidden
    # by the unresolved filter -- 948 settings invisible with no error anywhere.
    rc_l, ls_l, _ = podman(d, ["bash", "-c",
                               "ls %s/%s/*.adml 2>/dev/null" % (shq(root), shq(lang))])
    adml_by_lower = {}
    for x in (ls_l or "").split():
        if x.endswith(".adml"):
            adml_by_lower[x.rsplit("/", 1)[-1].lower()] = x
    policies, admx = [], []
    for f in files:
        name = f.rsplit("/", 1)[-1]
        admx.append(name)
        xml = _read_b64(d, f)
        if xml is None:
            continue
        adml_path = adml_by_lower.get((name[:-5] + ".adml").lower())
        adml = _read_b64(d, adml_path) if adml_path else None
        strings = parse_adml(adml) if adml else {}
        for p in parse_admx(xml):
            p["admx"] = name
            p["display"] = _resolve_ref(p.get("display", ""), strings) or p.get("id", "")
            p["explain"] = _resolve_ref(p.get("explain", ""), strings)
            disp = p["display"]
            p["unresolved"] = (not disp) or disp.startswith("string.") \
                or bool(re.match(r'^POL_[0-9A-Fa-f_]+$', disp))
            policies.append(p)
    return {"on": d, "loaded": bool(files), "admx_files": admx, "lang": lang,
            "policies": policies, "policy_count": len(policies),
            "resolved_count": sum(0 if p["unresolved"] else 1 for p in policies)}

# ---- settings catalog: all available settings, faceted by OS + subsystem --

def v_gpo_catalog(a):
    """Every AVAILABLE setting the editor can offer, each tagged with an OS
    type and subsystems (derived defaults + persisted overrides). Sources:
    ADMX policies in the central store, and the samba CSE preferences. The
    left pane auto-populates from this. Optional --os_type / --subsystem
    filter server-side; the UI also filters client-side.

    --source cse|admx limits WHICH source is built. `cse` is the important one:
    it SKIPS the ADMX parse entirely (thousands of policies, tens of seconds),
    so a caller that only needs the ten CSE preferences — e.g. the preferences
    modal's OS filter — is not billed for the whole central store.

    ADMX entries are served from the PERSISTENT cache (fast). --refresh true does
    a differential refresh first (re-ingest only newer ADMX, purge deleted);
    --rebuild true forces a full re-parse. When no cache exists yet the first
    call builds it. The result carries `cache_file` (the browser fswatches it),
    `cache_changed` (did this call rewrite it) and `cached_at`."""
    tags = _read_catalog_tags()
    fsource = a.get("source")             # "cse" | "admx" | None (both)
    entries = []
    admx_loaded = None                    # None => ADMX not consulted this call
    cache = _read_catalog_cache()
    cache_changed = False
    if fsource != "cse":
        want_refresh = str(a.get("refresh", "")).lower() in ("1", "true", "yes", "on")
        want_rebuild = str(a.get("rebuild", "")).lower() in ("1", "true", "yes", "on")
        if want_refresh or want_rebuild or not cache.get("admx"):
            cache, cache_changed, _stats = _refresh_catalog_cache(force=want_rebuild)
        admx_loaded = bool(cache.get("admx"))
        for p in _catalog_policies_from_cache(cache):
            af = p.get("admx", "")
            eid = "admx:%s:%s" % (af, p.get("id", ""))
            os_t, subs = _derive_tags("admx", af)
            ov = tags.get(eid)
            if ov:
                os_t = ov.get("os_type", os_t)
                subs = ov.get("subsystems", subs)
            cls = (p.get("class") or "BOTH").upper()
            if cls not in ("MACHINE", "USER"):
                cls = "BOTH"
            entries.append({
                "id": eid, "name": p.get("display") or p.get("id", ""),
                "source": "admx", "admx": af, "os_type": os_t, "subsystems": subs,
                "unresolved": p.get("unresolved", False),
                "keyname": p.get("key", ""), "valuename": p.get("valuename") or p.get("id", ""),
                "class": cls, "type": p.get("enabled_type") or "REG_DWORD",
                "enabled_type": p.get("enabled_type"), "enabled_data": p.get("enabled_data"),
                "disabled_type": p.get("disabled_type"), "disabled_data": p.get("disabled_data")})
    if fsource != "admx":
        for cse in GPO_CSES:
            eid = "cse:%s" % cse
            os_t, subs = _derive_tags("cse", cse)
            ov = tags.get(eid)
            if ov:
                os_t = ov.get("os_type", os_t)
                subs = ov.get("subsystems", subs)
            entries.append({"id": eid, "name": cse + " (preference)", "source": "cse",
                            "cse": cse, "os_type": os_t, "subsystems": subs})
    fos = a.get("os_type")
    fsub = a.get("subsystem")
    if fos:
        entries = [e for e in entries if e["os_type"] == fos]
    if fsub:
        entries = [e for e in entries if fsub in e["subsystems"]]
    return {"os_types": OS_TYPES, "subsystems": SUBSYSTEMS,
            "admx_loaded": admx_loaded, "entries": entries, "count": len(entries),
            "cache_file": CATALOG_CACHE_FILE, "cache_changed": cache_changed,
            "cached_at": cache.get("built")}

def v_gpo_catalog_tag(a):
    """Assign the OS type and subsystem array for one catalog setting; persists
    as an override. subsystems is a comma-separated subset of the known list."""
    eid = a["id"]
    os_t = a.get("os_type", "")
    if os_t and os_t not in OS_TYPES:
        raise Fail("os_type must be one of: %s" % ", ".join(OS_TYPES))
    subs = [s.strip() for s in (a.get("subsystems", "") or "").split(",") if s.strip()]
    bad = [s for s in subs if s not in SUBSYSTEMS]
    if bad:
        raise Fail("unknown subsystem(s): %s (valid: %s)"
                   % (", ".join(bad), ", ".join(SUBSYSTEMS)))
    tags = _read_catalog_tags()
    cur = tags.get(eid, {})
    if os_t:
        cur["os_type"] = os_t
    cur["subsystems"] = subs
    tags[eid] = cur
    _write_catalog_tags(tags)
    return {"id": eid, "os_type": cur.get("os_type"), "subsystems": cur.get("subsystems")}

# ---- template GPOs: backup / restore / stack ------------------------------

def v_gpo_backup(a):
    """Snapshot a GPO to the persistent template store so it can be reused."""
    d = pdc_emulator()
    gpo = _gpo_guid(a)
    name = re.sub(r'[^A-Za-z0-9_.-]', '_', a.get("name") or gpo.strip("{}"))
    dest = "%s/%s" % (GPO_TEMPLATE_DIR, name)
    rc, out, err = podman_auth(d,
        "mkdir -p %s && samba-tool gpo backup %s --tmpdir=%s"
        % (shq(dest), shq(gpo), shq(dest)), timeout=180)
    if rc != 0:
        raise Fail((err.strip() or out.strip())[-600:])
    return {"backed_up": gpo, "template": name, "path": dest, "on": d}

def v_gpo_template_list(a):
    """Everything usable as a stacking source: existing GPOs + saved backups."""
    d = pdc_emulator()
    rc, out, err = podman_auth(d, "samba-tool gpo listall")
    gpos = parse_gpo_listall(out) if rc == 0 else []
    rc2, ls, _ = podman(d, ["bash", "-c",
        "ls -1 %s 2>/dev/null" % shq(GPO_TEMPLATE_DIR)])
    backups = [x for x in (ls or "").split() if x]
    return {"on": d, "gpos": gpos, "backups": backups}

def v_gpo_template_stack(a):
    """Stack Administrative-Template settings from one or more SOURCE GPOs into
    a TARGET GPO, in order — later sources override earlier ones. Reads each
    source's registry.pol and applies the merged set with `gpo load`."""
    d = pdc_emulator()
    target = _gpo_guid(a, "target")
    sources = [s.strip() for s in a["sources"].split(",") if s.strip()]
    if not sources:
        raise Fail("sources must be a comma-separated list of GPO GUIDs")
    merged, layers = [], []
    for s in sources:
        if not re.match(r'^\{[0-9A-Fa-f-]{36}\}$', s):
            raise Fail("source %r is not a GPO GUID" % s)
        ent = _read_registry_pol(d, s)
        merged.extend(ent)              # order preserved; later overrides
        layers.append({"source": s, "settings": len(ent)})
    if not merged:
        raise Fail("no registry settings found on the source GPO(s)")
    _enforce_gpo_scope(_declared_gpo_os(target), merged, target)
    cmd = "samba-tool gpo load %s --machine-ext-name=%s --user-ext-name=%s" % (
        shq(target), shq(DEFAULT_REG_CSE), shq(DEFAULT_REG_CSE))
    payload = [{"keyname": e["keyname"], "valuename": e["valuename"],
                "class": e["class"], "type": e["type"], "data": e["data"]}
               for e in merged]
    rc, out, err = podman_auth(d, cmd, stdin=json.dumps(payload), timeout=180)
    if rc != 0:
        raise Fail((err.strip() or out.strip())[-600:])
    return {"target": target, "on": d, "layers": layers,
            "applied": len(payload)}

def v_gpo_restore(a):
    """Restore a saved template backup as a brand-NEW GPO."""
    d = pdc_emulator()
    tpl = re.sub(r'[^A-Za-z0-9_.-]', '_', a["template"])
    src = "%s/%s" % (GPO_TEMPLATE_DIR, tpl)
    rc, out, err = podman_auth(d,
        "samba-tool gpo restore %s %s" % (shq(a["name"]), shq(src)), timeout=180)
    if rc != 0:
        raise Fail((err.strip() or out.strip())[-600:])
    m = re.search(r'\{[0-9A-Fa-f-]{36}\}', out)
    return {"restored_as": a["name"], "gpo": m.group(0) if m else "",
            "from_template": tpl, "on": d}

# ---- GPO preferences (samba CSEs via `gpo manage`) ------------------------

def v_gpo_pref_list(a):
    d = pdc_emulator()
    gpo = _gpo_guid(a)
    cse = a["cse"]
    if cse not in GPO_CSES:
        raise Fail("cse must be one of: %s" % ", ".join(GPO_CSES))
    rc, out, err = podman_auth(d,
        "samba-tool gpo manage %s list %s" % (cse, shq(gpo)))
    if rc != 0:
        raise Fail((err.strip() or out.strip())[-400:])
    return {"gpo": gpo, "cse": cse, "on": d,
            "items": parse_gpo_manage_list(out)}

def v_gpo_pref_set(a):
    """Set a preference/CSE setting. Command shape varies per CSE; entry and
    value are appended when provided (motd/issue take only a value; smb_conf
    and security take entry + value)."""
    d = pdc_emulator()
    gpo = _gpo_guid(a)
    cse = a["cse"]
    if cse not in GPO_CSES:
        raise Fail("cse must be one of: %s" % ", ".join(GPO_CSES))
    # samba Unix CSE preferences are Linux-only; never let them onto a Windows GPO.
    if _declared_gpo_os(gpo) == "Windows":
        raise Fail("GPO %s is scoped Windows-exclusive; preferences (samba Unix "
                   "CSEs) are Linux-only. Use a Linux GPO." % gpo)
    cmd = "samba-tool gpo manage %s set %s" % (cse, shq(gpo))
    if a.get("entry"):
        cmd += " " + shq(a["entry"])
    if a.get("value"):
        cmd += " " + shq(a["value"])
    rc, out, err = podman_auth(d, cmd, timeout=120)
    if rc != 0:
        raise Fail((err.strip() or out.strip())[-400:])
    return {"gpo": gpo, "cse": cse, "entry": a.get("entry", ""),
            "set": bool(a.get("value")), "on": d, "output": (out or "").strip()[-300:]}

def v_gpo_show(a):
    """Rich GPO detail for the plugin's detail modal: metadata + links +
    registry settings count."""
    d = pdc_emulator()
    gpo = _gpo_guid(a)
    rc, out, err = podman_auth(d, "samba-tool gpo show " + shq(gpo))
    if rc != 0:
        raise Fail((err.strip() or out.strip())[-400:])
    meta = {}
    for line in out.splitlines():
        m = re.match(r'^([A-Za-z][\w ]*?)\s*:\s*(.*)$', line.strip())
        if m:
            meta[m.group(1).strip().lower().replace(" ", "_")] = m.group(2).strip()
    rc2, lout, _ = podman_auth(d, "samba-tool gpo listcontainers " + shq(gpo))
    links = re.findall(r'DN:\s*(.+)', lout) if rc2 == 0 else []
    scope, source = _resolve_gpo_os(d, gpo)
    return {"gpo": gpo, "on": d, "meta": meta, "links": links,
            "os_scope": scope or "", "os_source": source,
            "settings": _read_registry_pol(d, gpo)}

