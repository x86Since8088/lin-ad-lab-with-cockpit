def _rdn(dn):
    head = dn.split(",", 1)[0]
    return head.split("=", 1)[1] if "=" in head else head

def _parent_dn(dn):
    return dn.split(",", 1)[1] if "," in dn else ""

def _structural(classes):
    """The most-derived structural class = last objectClass value (AD orders
    the list top-down: top, person, organizationalPerson, user, computer)."""
    return classes[-1] if classes else ""

def _ldap_escape(s):
    for ch, rep in (("\\", "\\5c"), ("(", "\\28"), (")", "\\29"),
                    ("*", "\\2a"), ("\x00", "\\00")):
        s = s.replace(ch, rep)
    return s

def _search_filter(s):
    s = _ldap_escape(s)
    fields = ["cn", "name", "sAMAccountName", "displayName", "description", "mail"]
    return "(|%s)" % "".join("(%s=*%s*)" % (f, s) for f in fields)

def _ldb(dc, base, scope, filt="(objectClass=*)", attrs=None):
    if scope not in ("base", "one", "sub"):
        scope = "one"
    argv = ["ldbsearch", "-H", SAM, "-b", base, "-s", scope, filt]
    if attrs:
        argv += attrs
    rc, out, err = podman(dc, argv)
    if rc != 0:
        raise Fail(err.strip() or out.strip() or "ldbsearch failed")
    return parse_ldif_full(out)

def _class_entry(dc, ldap_name):
    ents = _ldb(dc, schema_dn(), "one",
                "(&(objectClass=classSchema)(lDAPDisplayName=%s))" % _ldap_escape(ldap_name),
                ["lDAPDisplayName", "subClassOf", "auxiliaryClass",
                 "systemAuxiliaryClass", "mustContain", "systemMustContain",
                 "mayContain", "systemMayContain", "rDNAttID"])
    return ents[0]["attrs"] if ents else None

def _resolve_class_attrs(dc, ldap_name):
    """Walk the subClassOf chain to `top` plus every auxiliary class (and their
    chains); union must/may. This is the object's full allowed attribute set —
    exactly what the Attribute Editor enumerates. Pure schema, no extra data."""
    mandatory, optional, chain = set(), set(), []
    seen, stack = set(), [ldap_name]
    while stack:
        cn = stack.pop()
        if not cn or cn in seen:
            continue
        seen.add(cn)
        a = _class_entry(dc, cn)
        if a is None:
            continue
        chain.append(cn)
        for k in ("mustContain", "systemMustContain"):
            mandatory.update(a.get(k, []))
        for k in ("mayContain", "systemMayContain"):
            optional.update(a.get(k, []))
        for k in ("auxiliaryClass", "systemAuxiliaryClass"):
            stack.extend(a.get(k, []))
        sub = (a.get("subClassOf") or [None])[0]
        if sub and sub != cn:          # top.subClassOf == top -> terminate
            stack.append(sub)
    optional -= mandatory
    return {"mandatory": mandatory, "optional": optional, "chain": chain}

def _attr_meta(dc, names):
    """Per-attribute schema metadata for a list of lDAPDisplayNames."""
    names = sorted({n for n in names if n})
    if not names:
        return {}
    ors = "".join("(lDAPDisplayName=%s)" % _ldap_escape(n) for n in names)
    ents = _ldb(dc, schema_dn(), "one",
                "(&(objectClass=attributeSchema)(|%s))" % ors,
                ["lDAPDisplayName", "attributeSyntax", "oMSyntax",
                 "isSingleValued", "systemOnly", "rangeUpper", "searchFlags",
                 "systemFlags", "linkID", "adminDisplayName"])
    meta = {}
    for e in ents:
        a = e["attrs"]
        ln = (a.get("lDAPDisplayName") or [""])[0]
        if not ln:
            continue
        syn = (a.get("attributeSyntax") or [""])[0]
        single = (a.get("isSingleValued") or ["FALSE"])[0].upper() == "TRUE"
        system_only = (a.get("systemOnly") or ["FALSE"])[0].upper() == "TRUE"
        try:
            sysflags = int((a.get("systemFlags") or ["0"])[0] or 0)
        except ValueError:
            sysflags = 0
        constructed = bool(sysflags & 0x00000004)   # FLAG_ATTR_IS_CONSTRUCTED
        try:
            link = int((a.get("linkID") or ["0"])[0] or 0)
        except ValueError:
            link = 0
        backlink = link != 0 and link % 2 == 1       # odd linkID = computed back-link
        typ = AD_SYNTAX.get(syn, "text")
        try:
            maxlen = int((a.get("rangeUpper") or [""])[0])
        except ValueError:
            maxlen = None
        if typ == "text" and maxlen and maxlen > 256:
            typ = "multitext"
        meta[ln] = {"attr": ln, "syntax": syn,
                    "omsyntax": (a.get("oMSyntax") or [""])[0],
                    "type": typ, "multi": not single,
                    # back-links (odd linkID) are server-computed and reject
                    # direct writes even when the schema leaves systemOnly FALSE
                    "readonly": system_only or constructed or backlink,
                    "maxlen": maxlen,
                    "label": (a.get("adminDisplayName") or [ln])[0]}
    return meta

def _display_names(dc, ldap_class):
    """The class's en-US (409) displaySpecifier: friendly attribute labels,
    the friendly class name, and the ordered property-page GUID list."""
    dn = "CN=%s-Display,CN=409,CN=DisplaySpecifiers,%s" % (ldap_class, config_dn())
    try:
        ents = _ldb(dc, dn, "base", "(objectClass=*)",
                    ["attributeDisplayNames", "classDisplayName",
                     "adminPropertyPages"])
    except Fail:
        ents = []
    labels, pages, class_label = {}, [], ""
    if ents:
        a = ents[0]["attrs"]
        class_label = (a.get("classDisplayName") or [""])[0]
        for pair in a.get("attributeDisplayNames", []):
            if "," in pair:
                k, v = pair.split(",", 1)
                labels.setdefault(k, v)
        pages = a.get("adminPropertyPages", [])
    return {"labels": labels, "class_label": class_label, "pages": pages}

def _ldif_value_line(attr, val):
    """One LDIF value line, base64-encoded unless the value is an LDIF
    SAFE-STRING. This is what stops a value that contains a newline from
    injecting extra modify operations into the change record."""
    s = "" if val is None else str(val)
    safe = bool(s) and s[0] not in (" ", ":", "<") and \
        all(32 <= ord(c) <= 126 for c in s)
    if safe:
        return "%s: %s" % (attr, s)
    b = base64.b64encode(s.encode("utf-8")).decode("ascii")
    return "%s:: %s" % (attr, b)

def _norm_dn(dn):
    return ",".join(p.strip() for p in str(dn).split(",")).lower()

def _critical_dns():
    """DNs the helper refuses to delete or rename — the naming-context heads,
    the default containers, and the well-known critical principals. A denylist,
    because the UI's typed-confirmation is bypassable by a direct helper call."""
    d = domain_dn()
    heads = {_norm_dn(domain_dn()), _norm_dn(config_dn()), _norm_dn(schema_dn())}
    for rdn in ("CN=Users", "CN=Builtin", "CN=Computers", "CN=System",
                "OU=Domain Controllers", "CN=Managed Service Accounts",
                "CN=ForeignSecurityPrincipals", "CN=Program Data",
                "CN=LostAndFound", "CN=Infrastructure"):
        heads.add(_norm_dn("%s,%s" % (rdn, d)))
    for cn in ("Administrator", "Guest", "krbtgt", "Domain Admins",
               "Enterprise Admins", "Schema Admins", "Domain Users",
               "Domain Controllers", "Group Policy Creator Owners",
               "Cert Publishers", "Read-only Domain Controllers"):
        heads.add(_norm_dn("CN=%s,CN=Users,%s" % (cn, d)))
    heads.add(_norm_dn("CN=Administrators,CN=Builtin,%s" % d))
    return heads

def _guard_critical(dn, action):
    if _norm_dn(dn) in _critical_dns():
        raise Fail("refusing to %s a critical directory object: %s" % (action, dn))

def v_object_tree(a):
    d = first_up_dc()
    system = (a.get("system") or "").lower() in ("1", "yes", "true")
    base = domain_dn()
    filt = ("(|(objectClass=organizationalUnit)(objectClass=container)"
            "(objectClass=builtinDomain)(objectClass=domainDNS)"
            "(objectClass=lostAndFound)(objectClass=msDS-QuotaContainer))")
    ents = _ldb(d, base, "sub", filt, ["name", "cn", "ou", "objectClass"])
    nodes = []
    for e in ents:
        dn, at = e["dn"], e["attrs"]
        rdn_names = [p.split("=", 1)[-1] for p in dn.split(",")]
        is_sys = dn != base and any(n in SYSTEM_RDNS for n in rdn_names)
        if is_sys and not system:
            continue
        nodes.append({
            "dn": dn,
            "name": (at.get("ou") or at.get("name") or at.get("cn") or [_rdn(dn)])[0],
            "class": _structural(at.get("objectClass", [])),
            "system": is_sys,
            "parent": _parent_dn(dn),
        })
    nodes.sort(key=lambda n: n["dn"].lower())
    return {"base": base, "count": len(nodes), "nodes": nodes}

def v_object_list(a):
    d = first_up_dc()
    base = a["base"]
    scope = a.get("scope", "one")
    classes = [c for c in (a.get("classes", "") or "").split(",") if c]
    search = (a.get("search") or "").strip()
    extra = [x for x in (a.get("attrs", "") or "").split(",") if x]
    try:
        limit = int(a.get("limit") or 2000)
    except ValueError:
        limit = 2000
    use = classes or DEFAULT_LIST_CLASSES
    parts = [OBJECT_CLASS_FILTERS.get(c, "(objectClass=%s)" % _ldap_escape(c)) for c in use]
    clsf = "(|%s)" % "".join(parts) if len(parts) > 1 else parts[0]
    conds = [clsf]
    if search:
        conds.append(_search_filter(search))
    filt = "(&%s)" % "".join(conds) if len(conds) > 1 else conds[0]
    want = ["objectClass", "name", "cn", "sAMAccountName", "displayName",
            "description"]
    for x in extra:
        if x not in want:
            want.append(x)
    ents = _ldb(d, base, scope, filt, want)
    rows = []
    for e in ents:
        if e["dn"] == base:
            continue
        at = e["attrs"]
        row_attrs = {}
        for k in want:
            if k == "objectClass":
                continue
            vs = at.get(k)
            if vs:
                row_attrs[k] = vs[0]
        rows.append({
            "dn": e["dn"],
            "name": (at.get("name") or at.get("cn") or [_rdn(e["dn"])])[0],
            "class": _structural(at.get("objectClass", [])),
            "attrs": row_attrs,
        })
        if len(rows) >= limit:
            break
    return {"base": base, "count": len(rows),
            "truncated": len(ents) > len(rows),
            "columns": extra or DEFAULT_COLUMNS, "objects": rows}

def v_object_get(a):
    d = first_up_dc()
    dn = a["dn"]
    want = ["*", "memberOf"]
    if (a.get("acl") or "").lower() in ("1", "yes", "true"):
        want.append("nTSecurityDescriptor")
    ents = _ldb(d, dn, "base", "(objectClass=*)", want)
    if not ents:
        raise Fail("object not found: %s" % dn)
    e = ents[0]
    at = e["attrs"]
    cls = at.get("objectClass", [])
    result = {"dn": e["dn"],
              "name": (at.get("name") or at.get("cn") or [_rdn(dn)])[0],
              "classes": cls, "structural_class": _structural(cls),
              "attrs": at, "b64": e["b64"]}
    # the protection lookup is an extra dsacl subprocess — only when asked for
    if (a.get("protected") or "").lower() in ("1", "yes", "true"):
        result["protected"] = _is_protected(d, e["dn"])
    return result

def v_object_schema(a):
    d = first_up_dc()
    cls = a.get("class")
    if not cls:
        dn = a.get("dn")
        if not dn:
            raise Fail("need --class or --dn")
        ents = _ldb(d, dn, "base", "(objectClass=*)", ["objectClass"])
        if not ents:
            raise Fail("object not found: %s" % dn)
        cls = _structural(ents[0]["attrs"].get("objectClass", []))
    res = _resolve_class_attrs(d, cls)
    allowed = sorted(res["mandatory"] | res["optional"])
    meta = _attr_meta(d, allowed)
    disp = _display_names(d, cls)
    labels = disp["labels"]

    def enrich(attr, kind=None):
        m = dict(meta.get(attr, {"attr": attr, "type": "text", "multi": False,
                                 "readonly": False, "maxlen": None}))
        m["attr"] = attr
        m["label"] = labels.get(attr) or m.get("label") or attr
        m["mandatory"] = attr in res["mandatory"]
        if kind:
            m["kind"] = kind
        return m

    attributes = [enrich(x) for x in allowed]
    allowed_set = set(allowed)
    tabs = []
    for tab in OBJECT_FORMS.get(cls, OBJECT_FORMS["default"]):
        fields = []
        for f in tab["fields"]:
            attr = f if isinstance(f, str) else f["attr"]
            kind = None if isinstance(f, str) else f.get("kind")
            if attr not in allowed_set:      # self-heal against the live schema
                continue
            fields.append(enrich(attr, kind))
        if fields:
            tabs.append({"id": tab["id"], "label": tab["label"], "fields": fields})
    return {"structural_class": cls,
            "class_label": disp.get("class_label") or cls,
            "tabs": tabs, "attributes": attributes,
            "mandatory": sorted(res["mandatory"]),
            "chain": res["chain"], "pages": disp.get("pages", [])}

def _b64_display(v):
    """Render a base64 value the same way parse_ldif_full renders a stored one,
    so a b64 write can be compared against the read-back."""
    try:
        dec = base64.b64decode(v).decode("utf-8")
        if any(ord(c) < 32 and c not in "\t\n\r" for c in dec):
            raise ValueError
        return dec
    except Exception:
        try:
            return base64.b64decode(v).hex().upper()
        except Exception:
            return v

def _verify_changes(dc, dn, changes, meta_lc):
    """Read the touched attributes back and report requested vs. observed per
    change, honestly (ok=False when a value did not take). Attribute names match
    case-insensitively (LDAP is), DN-syntax values compare normalised (the
    server canonicalises them), and b64 values are decoded before comparing."""
    names = sorted({ch["attr"] for ch in changes if isinstance(ch, dict) and ch.get("attr")})
    cur_lc = {}
    if names:
        ents = _ldb(dc, dn, "base", "(objectClass=*)", names)
        if ents:
            cur_lc = {k.lower(): v for k, v in ents[0]["attrs"].items()}
    applied, all_ok = [], True
    for ch in changes:
        attr = ch["attr"]
        lc = attr.lower()
        op = ch.get("op", "replace")
        is_dn = meta_lc.get(lc, {}).get("type") == "dn"
        norm = (lambda v: _norm_dn(v)) if is_dn else (lambda v: v)
        raw_req = [v for v in (ch.get("values") or []) if v not in (None, "")]
        req = [_b64_display(v) for v in raw_req] if ch.get("b64") else raw_req
        obs = cur_lc.get(lc, [])
        obs_n = [norm(v) for v in obs]
        req_n = [norm(v) for v in req]
        if op == "replace":
            ok = sorted(obs_n) == sorted(req_n)
        elif op == "add":
            ok = all(v in obs_n for v in req_n)
        elif op == "delete":
            ok = (not obs) if not req else all(v not in obs_n for v in req_n)
        else:
            ok = None
        if ok is False:
            all_ok = False
        applied.append({"attr": attr, "op": op, "requested": ch.get("values") or [],
                        "observed": obs, "ok": ok})
    return applied, all_ok

# ---- Remote Desktop Services (Terminal Server) licensing ------------------
# An RD Licensing server must join the built-in "Terminal Server License
# Servers" group (well-known SID S-1-5-32-561) to ISSUE and TRACK Per-User RDS
# CALs. Per-user tracking works by the license server writing the per-user CAL
# attributes (msTSExpireDate / msTSManagingLS / msTSLicenseVersion) onto each
# USER object; the permission is delegated by ACEs granting the group Read/Write
# on the "Terminal Server License Server" property set (5805bc62). Samba stamps
# these ACEs onto every user object at creation by default (verified: a fresh
# user carries (OA;;RPWP;5805bc62-...;;S-1-5-32-561)), so on this lab the group,
# the schema attributes AND the delegation are all present out of the box.
# rds-ensure therefore just verifies; it remediates (an inherited ACE on the
# domain head, applying to all users) only in the unlikely event a user object
# is found lacking the delegation.
RDS_LS_GROUP_SID = "S-1-5-32-561"
RDS_LS_GROUP_NAME = "Terminal Server License Servers"
RDS_CAL_PROPSET = "5805bc62-bdc9-4428-a5e2-856a0f4c185e"      # "Terminal Server License Server" property set (per-user CAL attrs)
RDS_USER_CLASS_GUID = "bf967aba-0de6-11d0-a285-00aa003049e2"  # user classSchema (inherited-object-type)
# Remediation ACE only (Samba's per-user default is the normal source of the
# delegation): (OA)=object, (CIIO)=container-inherit + inherit-only onto user
# objects, (RPWP)=read+write property on the set.
RDS_CAL_ACE = "(OA;CIIO;RPWP;%s;%s;%s)" % (RDS_CAL_PROPSET, RDS_USER_CLASS_GUID, RDS_LS_GROUP_SID)


def _rds_group_dn(d):
    rc, out, _ = podman(d, ["ldbsearch", "-H", SAM, "(objectSid=%s)" % RDS_LS_GROUP_SID, "dn"])
    for line in out.splitlines():
        if line.lower().startswith("dn:"):
            return line.split(":", 1)[1].strip()
    return None


def _rds_delegation_present(d):
    """True if a sample USER object grants the group RPWP on the TS-license
    property set -- Samba stamps this per-user by default, so this is the correct
    place to check (not the domain head). None when there are no users to sample."""
    rc, out, _ = podman(d, ["ldbsearch", "-H", SAM,
                            "(&(objectClass=user)(objectCategory=person))", "dn"])
    dn = None
    for line in out.splitlines():
        if line.lower().startswith("dn:"):
            dn = line.split(":", 1)[1].strip()
            break
    if not dn:
        return None
    rc, sd, _ = podman(d, ["samba-tool", "dsacl", "get", "--objectdn", dn])
    return bool(rc == 0 and RDS_LS_GROUP_SID in sd and RDS_CAL_PROPSET in sd)


def v_rds_status(a):
    """Report the Remote Desktop / Terminal Server licensing support structure in
    AD: the built-in license-servers group, its members, the per-user-CAL schema
    attributes, whether user objects carry the CAL-write delegation for the
    group, and any site license-server SCP."""
    d = pdc_emulator()
    gdn = _rds_group_dn(d)
    members = []
    if gdn:
        rc, out, _ = podman(d, ["ldbsearch", "-H", SAM, "-b", gdn, "-s", "base", "member"])
        members = [l.split(":", 1)[1].strip() for l in out.splitlines() if l.lower().startswith("member:")]
    rc, so, _ = podman(d, ["ldbsearch", "-H", SAM, "--cross-ncs",
                           "(lDAPDisplayName=msTSExpireDate)", "lDAPDisplayName"])
    schema_ok = "msTSExpireDate" in so
    rc, sc, _ = podman(d, ["ldbsearch", "-H", SAM, "--cross-ncs",
                           "(objectClass=licensingSiteSettings)", "dn", "siteServer"])
    lss = parse_ldif_full(sc)
    scps = [e["dn"] for e in lss]
    # Each published site's license server: the siteServer value on its
    # licensingSiteSettings object. Attribute names come back in schema case, so
    # match case-insensitively.
    site_servers = []
    for e in lss:
        lc = {k.lower(): v for k, v in e["attrs"].items()}
        for v in lc.get("siteserver", []):
            site_servers.append({"site_settings_dn": e["dn"], "site_server": v})
    return {"group": RDS_LS_GROUP_NAME, "group_sid": RDS_LS_GROUP_SID, "group_dn": gdn,
            "group_present": bool(gdn), "members": members,
            "per_user_cal_schema": schema_ok,
            "per_user_delegation": _rds_delegation_present(d),
            "site_license_scps": scps,
            "site_license_servers": site_servers, "on": d}


def v_rds_ensure(a):
    """Ensure the RDS Per-User CAL support structure. The built-in group and the
    per-user delegation are provisioned by Samba, so this is normally a verifying
    no-op; if a user object is found LACKING the delegation, it is remediated by
    adding an inherited ACE for the group on the domain head. Idempotent."""
    d = pdc_emulator()
    gdn = _rds_group_dn(d)
    if not gdn:
        raise Fail("%s (%s) is missing -- re-provision the domain; a builtin "
                   "well-known group is not something to recreate by hand"
                   % (RDS_LS_GROUP_NAME, RDS_LS_GROUP_SID))
    present = _rds_delegation_present(d)
    added = False
    if present is False:
        rc, out, err = podman(d, ["samba-tool", "dsacl", "set",
                                  "--objectdn", domain_dn(), "--sddl", RDS_CAL_ACE])
        if rc != 0:
            raise Fail(err.strip() or out.strip() or "dsacl set failed")
        added = True
        present = True
    return {"group_dn": gdn, "per_user_delegation": present,
            "delegation_ace_added": added, "on": d}


def v_rds_add_server(a):
    """Add a computer (an RD Licensing server) to the Terminal Server License
    Servers group so it can issue/track Per-User CALs -- verifying the per-user
    delegation is in place first."""
    d = pdc_emulator()
    v_rds_ensure({})
    member = a["server"].strip()
    rc, out, err = podman(d, ["samba-tool", "group", "addmembers", RDS_LS_GROUP_NAME, member])
    if rc != 0:
        raise Fail(err.strip() or out.strip())
    return {"group": RDS_LS_GROUP_NAME, "added": member, "on": d}


# ---- RDS site-level publishing (Enterprise license server) ----------------
# Session hosts discover their site's Enterprise license server through a
# licensingSiteSettings object published directly under the site, whose
# `siteServer` attribute is the license server's computer DN. The class is
# structural (governsID 1.2.840.113556.1.5.78, subClassOf applicationSiteSettings,
# rDNAttID cn, NO mustContain — only systemMayContain siteServer), so the object
# needs nothing but its objectClass, cn and siteServer; the RDN, by exact analogy
# with the "NTDS Site Settings" object, is "Licensing Site Settings". The
# site-level PERMISSION is an ACE letting the license server's computer account
# write the siteServer property on that object, so it can maintain (re-register)
# its own registration — the same delegation pattern as RDS_CAL_ACE, but a
# write-property on one object rather than an inherited property-set grant.
RDS_SITE_SETTINGS_CN = "Licensing Site Settings"
RDS_SITESERVER_ATTR_GUID = "1be8f17c-a9ff-11d0-afe2-00c04fd930c9"  # siteServer attributeSchema schemaIDGUID


def _rds_site_permission_ace(sid):
    """SDDL ACE granting `sid` write-property on the siteServer attribute of the
    Licensing Site Settings object. (OA)=object ACE, no inheritance (applies to
    the object itself), (WP)=write-property, object-type = the siteServer attr."""
    return "(OA;;WP;%s;;%s)" % (RDS_SITESERVER_ATTR_GUID, sid)


def _sites_container_dn():
    return "CN=Sites," + config_dn()


def _rds_resolve_site(d, name=None):
    """Resolve a site to its DN. With no name, the (only/first) site; if there is
    more than one, require --site to disambiguate."""
    base = _sites_container_dn()
    n = (name or "").strip()
    if n:
        if "=" in n:                                    # already a DN
            ents = _ldb(d, n, "base", "(objectClass=site)", ["cn"])
            if not ents:
                raise Fail("no site at %s" % n)
            return ents[0]["dn"]
        ents = _ldb(d, base, "one",
                    "(&(objectClass=site)(cn=%s))" % _ldap_escape(n), ["cn"])
        if not ents:
            raise Fail("site %r not found under %s" % (n, base))
        return ents[0]["dn"]
    ents = _ldb(d, base, "one", "(objectClass=site)", ["cn"])
    if not ents:
        raise Fail("no site found under %s" % base)
    if len(ents) > 1:
        names = ", ".join(sorted(e["dn"].split(",", 1)[0][3:] for e in ents))
        raise Fail("multiple sites (%s) — pass --site to choose one" % names)
    return ents[0]["dn"]


def _rds_resolve_computer(d, name):
    """Resolve a computer account (short name, NAME$, or a full DN) to
    (dn, objectSid) — the same name→object resolution rds-add-server delegates to
    samba-tool, done here because we need both the DN (for siteServer) and the SID
    (for the ACE). ldbsearch decodes objectSid to its S-1-5-… string form."""
    nm = (name or "").strip()
    if not nm:
        raise Fail("server is required")
    if "=" in nm:                                        # a DN
        ents = _ldb(d, nm, "base", "(objectClass=computer)", ["objectSid"])
        if not ents:
            raise Fail("no computer object at %s" % nm)
    else:
        sam = nm if nm.endswith("$") else nm + "$"
        ents = _ldb(d, domain_dn(), "sub",
                    "(&(objectClass=computer)(sAMAccountName=%s))" % _ldap_escape(sam),
                    ["objectSid"])
        if not ents:
            raise Fail("computer %r not found" % nm)
    dn = ents[0]["dn"]
    lc = {k.lower(): v for k, v in ents[0]["attrs"].items()}
    sids = lc.get("objectsid", [])
    if not sids:
        raise Fail("could not read objectSid of %s" % dn)
    return dn, sids[0]


def _rds_find_site_settings(d, site_dn):
    """The licensingSiteSettings object under a site, or None — matched by class,
    not name, so a differently-named object is still found."""
    ents = _ldb(d, site_dn, "one", "(objectClass=licensingSiteSettings)",
                ["siteServer", "cn"])
    return ents[0] if ents else None


def _rds_site_permission_present(d, ss_dn, sid):
    """True if `sid` already has an allow ACE on ss_dn granting write to the
    siteServer property (WP on the attr GUID, or WP/generic-write on the whole
    object)."""
    rc, sd, _ = podman(d, ["samba-tool", "dsacl", "get", "--objectdn", ss_dn])
    if rc != 0:
        return False
    for ace in re.findall(r'\(([^)]*)\)', sd):
        parts = ace.split(";")
        if len(parts) != 6:
            continue
        atype, _flags, rights, objtype, _inh, trustee = parts
        if atype not in ("A", "OA") or trustee != sid:
            continue
        if "WP" not in rights and "GA" not in rights and "GW" not in rights:
            continue
        if objtype == "" or objtype.lower() == RDS_SITESERVER_ATTR_GUID.lower():
            return True
    return False


def _rds_grant_site_permission(d, ss_dn, sid):
    """Idempotently add the write-siteServer ACE for the computer SID. Returns
    True if it was added, False if already present."""
    if _rds_site_permission_present(d, ss_dn, sid):
        return False
    rc, out, err = podman(d, ["samba-tool", "dsacl", "set", "--objectdn", ss_dn,
                              "--sddl", _rds_site_permission_ace(sid)])
    if rc != 0:
        raise Fail(err.strip() or out.strip() or "dsacl set failed")
    return True


def v_rds_publish_site(a):
    """Publish an RD Licensing server as a site's Enterprise license server:
    create the CN=Licensing Site Settings licensingSiteSettings object under the
    site if absent, set siteServer to the server's computer DN, and grant that
    computer write-property on siteServer so it can maintain its own registration.
    Idempotent — re-running is a no-op when already correct."""
    d = pdc_emulator()
    site_dn = _rds_resolve_site(d, a.get("site"))
    comp_dn, comp_sid = _rds_resolve_computer(d, a["server"])
    obj = _rds_find_site_settings(d, site_dn)
    created = False
    if obj is None:
        ss_dn = "CN=%s,%s" % (RDS_SITE_SETTINGS_CN, site_dn)
        ldif = ("dn: %s\nobjectClass: licensingSiteSettings\ncn: %s\n%s\n"
                % (ss_dn, RDS_SITE_SETTINGS_CN, _ldif_value_line("siteServer", comp_dn)))
        rc, out, err = podman(d, ["ldbadd", "-H", SAM], stdin=ldif)
        if rc != 0:
            raise Fail(err.strip() or out.strip() or "ldbadd failed")
        created = True
        cur = [comp_dn]
    else:
        ss_dn = obj["dn"]
        lc = {k.lower(): v for k, v in obj["attrs"].items()}
        cur = lc.get("siteserver", [])
    server_changed = False
    if [_norm_dn(v) for v in cur] != [_norm_dn(comp_dn)]:
        ldif = ("dn: %s\nchangetype: modify\nreplace: siteServer\n%s\n-\n"
                % (ss_dn, _ldif_value_line("siteServer", comp_dn)))
        rc, out, err = podman(d, ["ldbmodify", "-H", SAM], stdin=ldif)
        if rc != 0:
            raise Fail(err.strip() or out.strip() or "ldbmodify failed")
        server_changed = True
    perm_added = _rds_grant_site_permission(d, ss_dn, comp_sid)
    return {"site": site_dn.split(",", 1)[0][3:], "site_dn": site_dn,
            "site_settings_dn": ss_dn, "site_server": comp_dn,
            "site_server_sid": comp_sid, "created": created,
            "site_server_changed": server_changed,
            "permission_ace": _rds_site_permission_ace(comp_sid),
            "permission_added": perm_added, "on": d}


def v_rds_site_permission(a):
    """Grant (idempotently) the license server's computer account write access to
    the siteServer property on the site's Licensing Site Settings object, so it
    can maintain its own registration. The object must already exist
    (rds-publish-site creates it)."""
    d = pdc_emulator()
    site_dn = _rds_resolve_site(d, a.get("site"))
    comp_dn, comp_sid = _rds_resolve_computer(d, a["server"])
    obj = _rds_find_site_settings(d, site_dn)
    if obj is None:
        raise Fail("no Licensing Site Settings object under %s — run "
                   "rds-publish-site first" % site_dn)
    ss_dn = obj["dn"]
    added = _rds_grant_site_permission(d, ss_dn, comp_sid)
    return {"site": site_dn.split(",", 1)[0][3:], "site_settings_dn": ss_dn,
            "site_server": comp_dn, "site_server_sid": comp_sid,
            "permission_ace": _rds_site_permission_ace(comp_sid),
            "permission_added": added, "on": d}


def v_rds_unpublish_site(a):
    """Remove a site's Enterprise license-server publication: delete the
    licensingSiteSettings object under the site (which carries the siteServer
    value and its ACE). Idempotent — a no-op when nothing is published."""
    d = pdc_emulator()
    site_dn = _rds_resolve_site(d, a.get("site"))
    obj = _rds_find_site_settings(d, site_dn)
    if obj is None:
        return {"site": site_dn.split(",", 1)[0][3:], "site_dn": site_dn,
                "removed": False, "on": d}
    ss_dn = obj["dn"]
    rc, out, err = podman(d, ["ldbdel", "-H", SAM, ss_dn])
    if rc != 0:
        raise Fail(err.strip() or out.strip() or "ldbdel failed")
    return {"site": site_dn.split(",", 1)[0][3:], "site_dn": site_dn,
            "site_settings_dn": ss_dn, "removed": True, "on": d}


# ---- object protection (protect from accidental deletion) -----------------
PROTECT_SDDL = "(D;;SDDT;;;WD)"   # Deny Everyone (WD): Delete + Delete-Tree

def _is_protected(dc, dn):
    """True if the object carries the accidental-deletion Deny ACE — a Deny to
    Everyone (WD) whose rights include both SD (delete) and DT (delete-tree).
    Note the ACE reads back with rights order normalised (e.g. DTSD)."""
    rc, out, _ = podman(dc, ["samba-tool", "dsacl", "get", "--objectdn", dn])
    if rc != 0:
        return False
    for m in re.finditer(r'\(D;[^;]*;([^;]*);[^;]*;[^;]*;WD\)', out):
        rights = m.group(1)
        if "SD" in rights and "DT" in rights:
            return True
    return False

def v_object_protect(a):
    dn, state = a["dn"], a["state"]
    d = pdc_emulator()
    verb = "set" if state == "on" else "delete"
    rc, out, err = podman(d, ["samba-tool", "dsacl", verb, "--objectdn", dn, "--sddl", PROTECT_SDDL])
    if rc != 0:
        raise Fail(err.strip() or out.strip() or ("dsacl %s failed" % verb))
    return {"dn": dn, "protected": _is_protected(d, dn), "on": d}

def v_object_modify(a):
    dn = a["dn"]
    try:
        changes = json.loads(a["changes"])
    except Exception as e:
        raise Fail("changes must be JSON: %s" % e)
    if not isinstance(changes, list) or not changes:
        raise Fail("changes must be a non-empty JSON array")
    d = pdc_emulator()
    # validate shape + refuse writes to read-only attributes up front, rather
    # than trusting ldbmodify's exit code (which no-ops such a write with rc 0).
    names = []
    for ch in changes:
        if not isinstance(ch, dict):
            raise Fail("each change must be an object {attr, op, values}")
        if not ch.get("attr"):
            raise Fail("each change needs an attr")
        if ch.get("op", "replace") not in ("replace", "add", "delete"):
            raise Fail("bad op %r (replace|add|delete)" % ch.get("op"))
        names.append(ch["attr"])
    metas = _attr_meta(d, names)
    # LDAP attribute names are case-insensitive; _attr_meta keys by the schema's
    # canonical lDAPDisplayName, so match case-insensitively or a lowercase name
    # would slip past the read-only guard (and ldbmodify would apply it).
    meta_lc = {k.lower(): v for k, v in metas.items()}
    for ch in changes:
        if meta_lc.get(ch["attr"].lower(), {}).get("readonly"):
            raise Fail("attribute %r is read-only (system-only or a computed "
                       "back-link) and cannot be modified" % ch["attr"])
    lines = ["dn: " + dn, "changetype: modify"]
    for ch in changes:
        attr, op, b64 = ch["attr"], ch.get("op", "replace"), bool(ch.get("b64"))
        lines.append("%s: %s" % (op, attr))
        for v in (ch.get("values") or []):
            if v is None or v == "":
                continue
            # b64 = caller-supplied base64; otherwise auto-encode any non-SAFE
            # value (closes the newline LDIF-injection).
            lines.append("%s:: %s" % (attr, v) if b64 else _ldif_value_line(attr, v))
        lines.append("-")
    ldif = "\n".join(lines) + "\n"
    rc, out, err = podman(d, ["ldbmodify", "-H", SAM], stdin=ldif)
    if rc != 0:
        raise Fail(err.strip() or out.strip() or "ldbmodify failed")
    applied, all_ok = _verify_changes(d, dn, changes, meta_lc)   # confirm it actually took
    return {"modified": dn, "on": d, "changes": len(changes),
            "applied": applied, "all_ok": all_ok}

def v_object_rename(a):
    _guard_critical(a["dn"], "rename")
    d = pdc_emulator()
    if _is_protected(d, a["dn"]):
        raise Fail("object is protected from accidental deletion — turn off protection first")
    rc, out, err = podman(d, ["ldbrename", "-H", SAM, a["dn"], a["new_dn"]])
    if rc != 0:
        raise Fail(err.strip() or out.strip() or "ldbrename failed")
    return {"renamed": a["dn"], "to": a["new_dn"], "on": d}

def v_object_delete(a):
    _guard_critical(a["dn"], "delete")
    d = pdc_emulator()
    if _is_protected(d, a["dn"]):
        raise Fail("object is protected from accidental deletion — turn off protection first")
    argv = ["ldbdel", "-H", SAM]
    if (a.get("recursive") or "").lower() in ("1", "yes", "true"):
        argv.append("--recursive")
    argv.append(a["dn"])
    rc, out, err = podman(d, argv)
    if rc != 0:
        raise Fail(err.strip() or out.strip() or "ldbdel failed")
    return {"deleted": a["dn"], "on": d}

def _relative_ou(parent):
    """samba-tool's --userou/--groupou/... want the container path WITHOUT the
    domain DN. Strip our domain suffix; empty means the default container."""
    d = domain_dn()
    p = (parent or "").strip()
    if not p or _norm_dn(p) == _norm_dn(d):
        return ""
    if _norm_dn(p).endswith(_norm_dn("," + d)):
        return p[:-(len(d) + 1)]     # drop the trailing ",<domain-dn>"
    return p

def _validate_name(name):
    """Reject DN/LDAP metacharacters so a crafted name can't redirect the DN
    (e.g. an OU name of 'x,OU=elsewhere' being interpolated into the DN)."""
    if not name or not name.strip():
        raise Fail("name is required")
    if name != name.strip():
        raise Fail("name must not have leading or trailing spaces")
    if name[0] == "#" or any(c in ',=+<>;"\\/\x00\n\r\t' for c in name):
        raise Fail('name must not contain any of  , = + < > ; " \\ /  a leading #  or control characters')

def _clean_st_err(s):
    """Strip samba-tool getpass prompt noise from an error string."""
    keep = []
    for line in (s or "").splitlines():
        t = line.strip()
        if not t or "GetPassWarning" in line or t.startswith(("New Password", "Retype Password", "Password:")):
            continue
        keep.append(line)
    return "\n".join(keep).strip()

def _find_created_dn(dc, cls, name, parent):
    """Resolve the DN of a just-created object — samba-tool may derive the RDN
    from a display name, so the caller can't reconstruct CN=<name>,<parent>."""
    try:
        if cls == "organizationalUnit":
            return "OU=%s,%s" % (name, parent)
        if cls in ("user", "group", "computer"):
            sam = name + "$" if cls == "computer" else name
            ents = _ldb(dc, domain_dn(), "sub", "(sAMAccountName=%s)" % _ldap_escape(sam), ["cn"])
            if ents:
                return ents[0]["dn"]
        ents = _ldb(dc, parent, "one", "(cn=%s)" % _ldap_escape(name), ["cn"])
        if ents:
            return ents[0]["dn"]
    except Fail:
        pass
    return None

def v_object_create(a):
    cls = a["class"]
    name = a["name"]
    _validate_name(name)
    parent = a.get("parent") or domain_dn()
    rel = _relative_ou(parent)
    given, surname, desc = a.get("given"), a.get("surname"), a.get("description")
    d = pdc_emulator()
    if cls == "organizationalUnit":
        argv = ["samba-tool", "ou", "create", "OU=%s,%s" % (name, parent)]
        if desc:
            argv += ["--description", desc]
    elif cls == "user":
        pw = _gen_password()
        argv = ["samba-tool", "user", "create", name]
        if rel:
            argv += ["--userou", rel]
        if given:
            argv += ["--given-name", given]
        if surname:
            argv += ["--surname", surname]
        if desc:
            argv += ["--description", desc]
        rc, out, err = podman(d, argv, stdin=pw + "\n" + pw + "\n")
        if rc != 0:
            raise Fail(_clean_st_err(err) or _clean_st_err(out) or "user create failed")
        return {"created": name, "class": cls, "in": parent, "on": d,
                "dn": _find_created_dn(d, cls, name, parent),
                "password": pw, "note": "password shown once; store it now"}
    elif cls == "group":
        argv = ["samba-tool", "group", "add", name]
        if rel:
            argv += ["--groupou", rel]
        if desc:
            argv += ["--description", desc]
    elif cls == "computer":
        argv = ["samba-tool", "computer", "create", name]
        if rel:
            argv += ["--computerou", rel]
        if desc:
            argv += ["--description", desc]
    elif cls == "contact":
        argv = ["samba-tool", "contact", "create", name]
        if rel:
            argv += ["--ou", rel]
        if given:
            argv += ["--given-name", given]
        if surname:
            argv += ["--surname", surname]
        if desc:
            argv += ["--description", desc]
    else:
        raise Fail("unsupported class %r" % cls)
    rc, out, err = podman(d, argv)
    if rc != 0:
        raise Fail(_clean_st_err(err) or _clean_st_err(out) or "create failed")
    return {"created": name, "class": cls, "in": parent, "on": d,
            "dn": _find_created_dn(d, cls, name, parent)}

# ---- GPO (gpmc.msc) — ALWAYS the PDC emulator -----------------------------

# ---- per-GPO OS scope: Windows-exclusive vs Linux-exclusive ---------------
# A GPO is created for exactly one OS so a Linux policy setting never applies on
# Windows and vice versa. This is enforced at the SOURCE — the write verbs
# refuse a setting whose OS differs from the GPO's declared scope — because that
# is the only reliable lever in this lab:
#   * Windows and Linux GP clients each process only their OWN settings
#     namespace. Windows applies registry.pol under Software\Policies\Microsoft
#     (+ the standard CSEs); the Linux clients (samba-gpupdate / adsys) apply
#     VGP + samba Unix CSEs and registry roots under
#     Software\Policies\{Ubuntu,Canonical,GNOME}, and each ignores the other's.
#   * WMI filters are NOT usable here: samba-tool cannot create them, and
#     samba-gpupdate reads gPCWQLFilter but never evaluates it (verified against
#     samba/gp/gpclass.py — the attribute is fetched, never acted on), so a
#     Win32_OperatingSystem filter fails OPEN on Linux (applied regardless).
# The declared scope is a small host-side map (like the catalog-tags file), so
# resolving/enforcing it needs no container round-trip. GPOs the plugin did not
# create carry no declared scope; an operator tags one with `gpo-set-os` to opt
# it into enforcement (its OS can still be INFERRED for display, see v_gpo_show).
GPO_OS_FILE = "/var/lib/adlab/gpo-os.json"   # host, root-only: {GUID: {os, set_at}}

def _norm_gpo_os(v):
    m = {"windows": "Windows", "win": "Windows", "linux": "Linux"}
    k = (v or "").strip().lower()
    if k not in m:
        raise Fail("os must be one of: %s" % ", ".join(OS_TYPES))
    return m[k]

def _read_gpo_os_map():
    try:
        with open(GPO_OS_FILE) as f:
            t = json.load(f)
            return t if isinstance(t, dict) else {}
    except (OSError, ValueError):
        return {}

def _write_gpo_os_map(m):
    os.makedirs(os.path.dirname(GPO_OS_FILE), exist_ok=True)
    with open(GPO_OS_FILE, "w") as f:
        json.dump(m, f, indent=2, sort_keys=True)
    os.chmod(GPO_OS_FILE, 0o600)

def _set_gpo_os(guid, os_):
    m = _read_gpo_os_map()
    m[guid.upper()] = {"os": os_, "set_at": _now_iso()}
    _write_gpo_os_map(m)

def _clear_gpo_os(guid):
    m = _read_gpo_os_map()
    if m.pop((guid or "").upper(), None) is not None:
        _write_gpo_os_map(m)

def _declared_gpo_os(guid):
    """The operator-declared OS scope for a GPO, or None. Cheap (no container)."""
    e = _read_gpo_os_map().get((guid or "").upper())
    return e.get("os") if isinstance(e, dict) else None

# Registry roots consumed by BOTH Windows and the Linux GP clients, so they are
# OS-agnostic and allowed in a GPO of either scope. Certificate Auto-Enrollment
# is Microsoft-rooted yet read by native Windows AND by samba's
# gp_cert_auto_enroll_ext AND by adsys (which reuses samba's implementation) --
# the one documented cross-OS setting.
SHARED_REG_ROOTS = ("software\\policies\\microsoft\\cryptography\\autoenrollment",
                    "software\\policies\\microsoft\\cryptography\\policyservers")

def _setting_os(keyname):
    """Which OS a registry.pol setting targets, by key namespace:
    'Linux' | 'Windows' | 'shared' (applies on both, e.g. cert auto-enrollment)."""
    k = (keyname or "").lower().replace("/", "\\")
    if any(k == r or k.startswith(r + "\\") for r in SHARED_REG_ROOTS):
        return "shared"
    return "Linux" if _is_linux_regkey(keyname) else "Windows"

def _enforce_gpo_scope(scope, entries, guid):
    """Refuse registry entries whose OS crosses a KNOWN scope. entries is a list
    of {keyname,...}. 'shared' settings are allowed in either scope; a None scope
    (undeclared GPO) is not enforced."""
    if not scope:
        return
    bad = sorted({e.get("keyname", "?") for e in entries
                  if _setting_os(e.get("keyname")) not in (scope, "shared")})
    if bad:
        other = "Linux" if scope == "Windows" else "Windows"
        shown = ", ".join(bad[:5]) + (" …" if len(bad) > 5 else "")
        raise Fail("GPO %s is scoped %s-exclusive; refusing %d %s-targeted "
                   "setting(s): %s. Use a %s GPO for these, or retag this GPO "
                   "with gpo-set-os." % (guid, scope, len(bad), other, shown, other))

def _infer_gpo_os(dc, guid):
    """(os, source) inferred from a GPO's SYSVOL contents when no scope is
    declared. source: inferred | mixed | unknown. Reads the container, so this
    is DISPLAY-only (v_gpo_show/gpo-set-os), never on the write hot path."""
    kinds = {_setting_os(e.get("keyname")) for e in _read_registry_pol(dc, guid)}
    lin, win = "Linux" in kinds, "Windows" in kinds
    if not lin:                       # VGP/samba Unix CSE artifacts are Linux too
        ev = _gpo_linux_evidence(dc, guid)
        lin = bool(ev.get("cse_artifacts") or ev.get("registry_keys"))
    if lin and not win:
        return "Linux", "inferred"
    if win and not lin:
        return "Windows", "inferred"
    if lin and win:
        return None, "mixed"
    return None, "unknown"

def _resolve_gpo_os(dc, guid):
    """(os, source): the declared scope if set, else inferred from SYSVOL."""
    d = _declared_gpo_os(guid)
    if d:
        return d, "declared"
    return _infer_gpo_os(dc, guid)


def v_gpo_list(a):
    d = pdc_emulator()
    rc, out, err = podman_auth(d, "samba-tool gpo listall")
    if rc != 0:
        raise Fail(err.strip() or out.strip())
    gpos = parse_gpo_listall(out)
    osmap = _read_gpo_os_map()
    for g in gpos:                    # cheap: declared scope only (no per-GPO read)
        e = osmap.get((g.get("gpo") or "").upper())
        g["os_scope"] = e.get("os") if isinstance(e, dict) else ""
    return {"pdc_emulator": d, "gpos": gpos, "os_types": list(OS_TYPES)}

def v_gpo_create(a):
    d = pdc_emulator()
    os_ = _norm_gpo_os(a["os"])
    rc, out, err = podman_auth(d, "samba-tool gpo create " + shq(a["name"]))
    if rc != 0:
        raise Fail(err.strip() or out.strip())
    m = re.search(r'\{[0-9A-Fa-f-]{36}\}', out)
    guid = m.group(0) if m else ""
    if guid:
        _set_gpo_os(guid, os_)
    return {"created": a["name"], "gpo": guid, "os": os_, "on": d,
            "note": "Scoped %s-exclusive: only %s-targeted settings may be "
                    "written to it. SYSVOL replication propagates it within 5 "
                    "minutes." % (os_, os_)}

def v_gpo_set_os(a):
    """Declare (or change) a GPO's OS scope — for GPOs the plugin did not create,
    or to retag. Verifies the GPO exists on the PDC emulator first."""
    d = pdc_emulator()
    gpo = _gpo_guid(a)
    os_ = _norm_gpo_os(a["os"])
    rc, out, err = podman_auth(d, "samba-tool gpo show " + shq(gpo))
    if rc != 0:
        raise Fail((err.strip() or out.strip())[-300:] or ("no such GPO %s" % gpo))
    _set_gpo_os(gpo, os_)
    return {"gpo": gpo, "os": os_, "on": d,
            "note": "Scoped %s-exclusive; the write verbs now refuse "
                    "non-%s settings." % (os_, os_)}

def v_gpo_delete(a):
    d = pdc_emulator()
    rc, out, err = podman_auth(d, "samba-tool gpo del " + shq(a["gpo"]))
    if rc != 0:
        raise Fail(err.strip() or out.strip())
    _clear_gpo_os(a["gpo"])
    return {"deleted": a["gpo"], "on": d}

def v_gpo_link(a):
    d = pdc_emulator()
