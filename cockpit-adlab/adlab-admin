# --------------------------------------------------------------------------
# Configuration resolution — DEPLOY-CONTRACT.md sections 4.1/4.3/4.4.
#
# adlab-admin never looks relative to itself and never discovers the tree. It
# reads /etc/cockpit-adlab/install.conf (written by install.sh) to find the
# deployed .env, then takes every storage location from that .env's six
# ADLAB_* keys. The .env carries locations and settings that are NOT in the
# system config; it is the operator's file, install.conf is the machine's.
#
# Resolution order (exactly section 4.3):
#   1. $ADLAB_ENV  — only when euid != 0 AND the file is owned by the caller.
#      Tests only; a root helper ignores it and says so on stderr, because an
#      env var that redirects a root process's config is a privilege escalation.
#   2. ENV_FILE= from /etc/cockpit-adlab/install.conf. The production path, and
#      the only one that exists on a deployed host.
#   3. Nothing — a lab verb then fails loudly, naming install.conf. No step 4;
#      there is deliberately NO "look beside me".
# --------------------------------------------------------------------------
PROJECT = "cockpit-adlab"
INSTALL_CONF = "/etc/%s/install.conf" % PROJECT
GPO_TEMPLATE_DEFAULT = "/var/lib/samba/gpo-templates"


def _parse_env(path):
    # The strict KEY=value grammar shared by .env and install.conf
    # (section 4.1): full-line '#' comments only, optional double quotes, no
    # interpolation. Returns {} on any read error — the caller decides if that
    # is fatal.
    out = {}
    try:
        with open(path) as fh:
            for line in fh:
                s = line.strip()
                if not s or s.startswith("#") or "=" not in s:
                    continue
                k, _, v = s.partition("=")
                k = k.strip()
                v = v.strip()
                if len(v) >= 2 and v[0] == '"' and v[-1] == '"':
                    v = v[1:-1]
                out[k] = v
    except OSError:
        pass
    return out


def _resolve_env_file():
    # Returns (path_or_None, source_label). Section 4.3 order, exactly.
    ov = os.environ.get("ADLAB_ENV")
    if ov:
        if os.geteuid() != 0:
            try:
                if os.stat(ov).st_uid == os.geteuid():
                    return ov, "env:ADLAB_ENV"
            except OSError:
                pass
        else:
            sys.stderr.write(
                "adlab-admin: $ADLAB_ENV ignored — a root helper takes its "
                "configuration only from %s\n" % INSTALL_CONF)
    ef = _parse_env(INSTALL_CONF).get("ENV_FILE", "").strip()
    if ef:
        return ef, "install.conf"
    return None, "unresolved"


ENV_FILE, ENV_SOURCE = _resolve_env_file()
_ENV = _parse_env(ENV_FILE) if ENV_FILE else {}

# Every storage location comes from the .env's six ADLAB_* keys — no
# derivation from a discovered root, no path relative to this file.
ADLAB_ROOT = _ENV.get("ADLAB_ROOT", "")
LAB_ENV = _ENV.get("ADLAB_LAB_ENV", "")
RDP_ENV = _ENV.get("ADLAB_RDP_ENV", "")
SYSVOL_REPL = _ENV.get("ADLAB_SYSVOL_REPLICATE", "")
SECRET_DIR = _ENV.get("ADLAB_SECRET_DIR", "")
GPO_TEMPLATE_DIR = _ENV.get("ADLAB_GPO_TEMPLATE_DIR", GPO_TEMPLATE_DEFAULT)
AUDIT_LOG = "/var/log/adlab-admin.log"
VERSION = "1.10.0"


def _require_config():
    # Lab verbs reach this via main(); meta verbs (schema/version/config) do
    # not. Section 4.3 step 3: fail loudly, naming install.conf.
    if not ENV_FILE:
        raise Fail("no lab configuration: %s is missing or has no ENV_FILE= — "
                   "run cockpit-adlab's install.sh" % INSTALL_CONF)
    if not LAB_ENV:
        raise Fail("%s (via %s) does not set ADLAB_LAB_ENV" % (ENV_FILE, ENV_SOURCE))

# --------------------------------------------------------------------------
# lab configuration (parsed from lab.env; defaults match the deployed lab)
# --------------------------------------------------------------------------

def load_lab(path=LAB_ENV, rdp_path=RDP_ENV):
    cfg = {
        "REALM": "AD.EDT1.LAB", "DOMAIN_DNS": "ad.edt1.lab",
        "DOMAIN_NB": "EDT1LAB", "DC_COUNT": 5, "CLIENT_COUNT": 10,
        "NET": "static-edt", "NET_PREFIX": "172.15.4",
        "DC_BASE": 10, "CLIENT_BASE": 20, "RDP_BASE": 30, "RDP_COUNT": 2,
        "FORWARDER": "8.8.8.8",
        "IMG_DC": "localhost/samba-ad-dc:latest",
        "IMG_CLIENT": "localhost/ad-client:latest",
        "ADMIN_PASS_FILE": os.path.join(SECRET_DIR, "administrator.pass") if SECRET_DIR else "",
    }
    ints = {"DC_COUNT", "CLIENT_COUNT", "DC_BASE", "CLIENT_BASE",
            "RDP_BASE", "RDP_COUNT"}
    for p in (path, rdp_path):
        try:
            with open(p) as f:
                for line in f:
                    m = re.match(r'^([A-Z_]+)="?([^"#\n]*)"?\s*(#.*)?$', line)
                    if m and m.group(1) in cfg:
                        v = m.group(2).strip()
                        cfg[m.group(1)] = int(v) if m.group(1) in ints else v
        except OSError:
            pass
    cfg["DOMAIN_DNS"] = cfg["REALM"].lower()
    # The credential file is ALWAYS ADLAB_SECRET_DIR + "/administrator.pass",
    # joined by us. lab.env writes ADMIN_PASS_FILE="$SECRET_DIR/administrator.pass"
    # for its own (bash) consumers; our KEY=value parser does not interpolate, so
    # we must derive it here rather than let that literal leak through.
    cfg["ADMIN_PASS_FILE"] = os.path.join(SECRET_DIR, "administrator.pass") if SECRET_DIR else ""
    return cfg

LAB = load_lab()
# The PRIMARY domain's config, pinned. main() reassigns LAB to the CURRENT
# domain per invocation, so anything that must always mean the primary forest
# (its identity, and the lab clients, which only ever join the primary) reads
# PRIMARY_LAB, never the mutable LAB.
PRIMARY_LAB = dict(LAB)

# --------------------------------------------------------------------------
# Domains. The lab was single-forest; it is now multi-forest. Each domain is an
# INDEPENDENT Samba forest of DC containers on ITS OWN podman network. The
# PRIMARY domain comes from lab.env (containers dc1..dcN on `static-edt`, and it
# is the only one with NO adlab.* labels — that is how we tell it apart).
# ADDITIONAL domains are created at runtime by `domain-add`; their DC containers
# carry adlab.* labels and are named <slug>-dc<N> on network adlab-<slug>.
#
# "Which domain am I acting on" is the module global CUR, resolved once per
# invocation from the global `--domain <realm>` option (default: primary). The
# six shared helpers below default to CUR, so every existing verb becomes
# domain-aware for free without touching its signature.
# --------------------------------------------------------------------------
DOM_LABEL = "adlab.realm"
CUR = None  # current domain context; set by main(); None == primary.


def _primary_domain():
    d = dict(PRIMARY_LAB)
    d["SLUG"] = ""
    d["PRIMARY"] = True
    return d


def _cur():
    return CUR if CUR is not None else _primary_domain()


def _label(name, key):
    rc, out, _ = RUN.run(["podman", "inspect", name, "--format",
                          '{{ index .Config.Labels "%s" }}' % key])
    return out.strip() if rc == 0 else ""


def _live_dcs_of(realm):
    # DC containers labelled with this realm, ordinal-sorted (<slug>-dc1, -dc2…).
    rc, out, _ = RUN.run(["podman", "ps", "-a", "--filter",
                          "label=%s=%s" % (DOM_LABEL, realm),
                          "--format", "{{.Names}}"])
    names = [n for n in out.split() if n] if rc == 0 else []
    return sorted(names, key=lambda n: (len(n), n))


def _domain_from_container(realm, ctr):
    base = dict(PRIMARY_LAB)  # inherit shared fields: forwarder, images, admin-pass, clients
    slug = _label(ctr, "adlab.slug") or realm.split(".")[0].lower()
    base.update({
        "REALM": realm,
        "DOMAIN_NB": _label(ctr, "adlab.domain_nb") or realm.split(".")[0].upper()[:15],
        "DOMAIN_DNS": realm.lower(),
        "NET": _label(ctr, "adlab.net") or ("adlab-" + slug),
        "NET_PREFIX": _label(ctr, "adlab.net_prefix") or "",
        "DC_BASE": int(_label(ctr, "adlab.dc_base") or "10"),
        "SLUG": slug,
        "PRIMARY": False,
        "PARENT": _label(ctr, "adlab.parent") or "",
    })
    return base


def list_domains():
    doms = [_primary_domain()]
    # NB: `podman ps` exposes labels as `.Labels` (a map); `.Config.Labels` is an
    # INSPECT-only field and comes back empty here — which silently hid every
    # additional forest until this was corrected.
    rc, out, _ = RUN.run(["podman", "ps", "-a", "--filter", "label=" + DOM_LABEL,
                          "--format", '{{.Names}}\t{{ index .Labels "%s" }}' % DOM_LABEL])
    reps = {}
    if rc == 0:
        for line in out.splitlines():
            parts = line.split("\t")
            if len(parts) >= 2 and parts[1] and parts[1] not in reps:
                reps[parts[1]] = parts[0]
    for realm, ctr in reps.items():
        doms.append(_domain_from_container(realm, ctr))
    return doms


def resolve_domain(realm=None):
    if not realm:
        return _primary_domain()
    for d in list_domains():
        if d["REALM"].lower() == realm.lower():
            return d
    raise Fail("no such domain: %s (see domain-list)" % realm)


def dc_name(i, dom=None):
    d = dom or _cur()
    s = d.get("SLUG", "")
    return ("%s-dc%d" % (s, i)) if s else ("dc%d" % i)


def dc_ip(i, dom=None):
    d = dom or _cur()
    return "%s.%d" % (d["NET_PREFIX"], d["DC_BASE"] + i - 1)


# Clients only ever join the PRIMARY forest, so they always read PRIMARY_LAB.
def client_name(i): return "client%d" % i
def client_ip(i):   return "%s.%d" % (PRIMARY_LAB["NET_PREFIX"], PRIMARY_LAB["CLIENT_BASE"] + i - 1)


def all_dcs(dom=None):
    d = dom or _cur()
    if d.get("PRIMARY", True):
        return [dc_name(i, d) for i in range(1, d["DC_COUNT"] + 1)]
    return _live_dcs_of(d["REALM"])


def all_clients(): return [client_name(i) for i in range(1, PRIMARY_LAB["CLIENT_COUNT"] + 1)]


def domain_dn(dom=None):
    d = dom or _cur()
    return "DC=" + ",DC=".join(d["DOMAIN_DNS"].split("."))

SAM = "/var/lib/samba/private/sam.ldb"

# --------------------------------------------------------------------------
# effects: every subprocess goes through the Runner so tests can fake it
# --------------------------------------------------------------------------

class Runner:
    def run(self, argv, stdin=None, timeout=120):
        """Returns (rc, stdout, stderr). Never raises on non-zero exit."""
        try:
            p = subprocess.run(argv, input=stdin, capture_output=True,
                               text=True, timeout=timeout)
            return p.returncode, p.stdout, p.stderr
        except subprocess.TimeoutExpired:
            return 124, "", "timeout after %ss: %s" % (timeout, argv[0])
        except OSError as e:
            return 127, "", str(e)

RUN = Runner()

def podman(ctr, args, stdin=None, timeout=120):
    argv = ["podman", "exec"]
    if stdin is not None:
        argv.append("-i")
    argv += [ctr] + args
    return RUN.run(argv, stdin=stdin, timeout=timeout)

def ctr_state(name):
    rc, out, _ = RUN.run(["podman", "inspect", name, "--format",
                          "{{.State.Status}}"])
    return out.strip() if rc == 0 else "missing"

def ctr_ip(name):
    rc, out, _ = RUN.run(["podman", "inspect", name, "--format",
                          "{{range $k,$v := .NetworkSettings.Networks}}{{$v.IPAddress}}{{end}}"])
    return out.strip() if rc == 0 else ""

def first_up_dc(dom=None):
    for d in all_dcs(dom):
        if ctr_state(d) == "running":
            return d
    raise Fail("no DC container is running%s" % (
        "" if (dom or _cur()).get("PRIMARY", True)
        else " for domain %s" % (dom or _cur())["REALM"]))

def pdc_emulator():
    """Which DC holds the PDC emulator role — queried, never hardcoded."""
    d = first_up_dc()
    rc, out, err = podman(d, ["samba-tool", "fsmo", "show"])
    if rc != 0:
        raise Fail("fsmo show failed on %s: %s" % (d, err.strip() or out.strip()))
    roles = parse_fsmo(out)
    holder = roles.get("PdcEmulationMasterRole", "")
    if not holder:
        raise Fail("could not determine the PDC emulator")
    return holder.lower()

class Fail(Exception):
    pass

# Run a samba-tool command that needs domain credentials. The password moves
# via a mode-600 authfile created and removed INSIDE the container in one
# bash -c; the host-side admin password file is mounted at /run/adminpass.
# The authfile path is UNIQUE per invocation (mktemp) so that two concurrent
# credentialed verbs against the same DC can never have one's trailing `rm -f`
# delete the file the other's samba-tool is still reading — a latent race a
# stress probe surfaced (unreached in practice because podman-exec overhead
# serialises the critical section, but eliminated here at zero cost).
AUTH_WRAP = (
    "umask 077; af=$(mktemp /run/adlab.auth.XXXXXX); "
    'printf "username=Administrator\\npassword=%s\\ndomain={nb}\\n" '
    '"$(cat /run/adminpass)" > "$af"; '
    '{cmd} -A "$af"; rc=$?; rm -f "$af"; exit $rc'
)

def podman_auth(ctr, cmd_str, timeout=120, stdin=None):
    # stdin (e.g. `gpo load` JSON) reaches the samba-tool command, not the
    # authfile printf, so the credential and the payload never collide.
    script = AUTH_WRAP.format(nb=LAB["DOMAIN_NB"], cmd=cmd_str)
    return podman(ctr, ["bash", "-c", script], timeout=timeout, stdin=stdin)


# AUTH_WRAP appends `-A "$af"` to its command and then immediately exits, which
# fits a single samba-tool invocation and nothing else. A verb that must read a
# file the credentialed command produced — and delete it — needs the read to
# happen INSIDE the authfile's lifetime and before that exit.
#
# AUTH_BODY_WRAP gives the body the authfile path in $af and lets it decide its
# own exit status. The body is responsible for using "$af"; the wrapper remains
# responsible for creating it 0600 and removing it on every path.
AUTH_BODY_WRAP = (
    "umask 077; af=$(mktemp /run/adlab.auth.XXXXXX); "
    'printf "username=Administrator\\npassword=%s\\ndomain={nb}\\n" '
    '"$(cat /run/adminpass)" > "$af"; '
    "{body}; rc=$?; rm -f \"$af\"; exit $rc"
)


def podman_auth_body(ctr, body, timeout=120, stdin=None):
    """Run an arbitrary shell body with a credential authfile at "$af"."""
    script = AUTH_BODY_WRAP.format(nb=LAB["DOMAIN_NB"], body=body)
    return podman(ctr, ["bash", "-c", script], timeout=timeout, stdin=stdin)

def shq(s):
    """Shell-quote one word for embedding in a bash -c string."""
    return "'" + str(s).replace("'", "'\\''") + "'"

# --------------------------------------------------------------------------
# pure parsers (unit-tested against captured samba-tool output)
# --------------------------------------------------------------------------

def parse_fsmo(text):
    """'SchemaMasterRole owner: CN=NTDS Settings,CN=DC2,...' -> {role: 'dc2'}"""
    roles = {}
    for m in re.finditer(r'^(\w+Role) owner: CN=NTDS Settings,CN=([^,]+),',
                         text, re.M):
        roles[m.group(1)] = m.group(2).lower()
    return roles

def parse_showrepl(text):
    """drs showrepl -> {dsa, neighbors: [{nc, partner, direction, ok,
    consecutive_failures, last_status}]}"""
    out = {"dsa": "", "neighbors": []}
    m = re.search(r'^DSA Options?:.*$|^DSA object GUID: (\S+)', text, re.M)
    direction = ""
    cur = None
    for line in text.splitlines():
        s = line.strip()
        if "INBOUND NEIGHBORS" in line:
            direction = "inbound"; continue
        if "OUTBOUND NEIGHBORS" in line:
            direction = "outbound"; continue
        if "KCC CONNECTION OBJECTS" in line:
            direction = ""; continue
        if not direction:
            continue
        if re.match(r'^(DC=|CN=)', s):
            cur = {"nc": s, "partner": "", "direction": direction,
                   "consecutive_failures": 0, "last_status": "", "ok": True}
            out["neighbors"].append(cur)
        elif cur is not None and " via RPC" in s:
            cur["partner"] = s.replace(" via RPC", "").strip()
        elif cur is not None and "consecutive failure" in s:
            n = re.match(r'(\d+) consecutive failure', s)
            if n:
                cur["consecutive_failures"] = int(n.group(1))
                cur["ok"] = cur["ok"] and int(n.group(1)) == 0
        elif cur is not None and s.startswith("Last attempt"):
            cur["last_status"] = s
            if "was successful" not in s:
                cur["ok"] = False
    return out

def parse_ldif_entries(text):
    """ldbsearch/samba-tool LDIF-ish output -> list of {attr: [values]}."""
    entries, cur = [], None
    for raw in text.splitlines():
        if not raw.strip():
            cur = None
            continue
        if raw.startswith("#"):
            continue
        m = re.match(r'^([A-Za-z][\w;-]*): (.*)$', raw)
        if not m:
            continue
        if m.group(1) == "dn" or cur is None:
            cur = {}
            entries.append(cur)
        cur.setdefault(m.group(1), []).append(m.group(2))
    return [e for e in entries if e]

def parse_ldif_full(text):
    """ldbsearch LDIF -> [{"dn":str, "attrs":{name:[str]}, "b64":{name:[bool]}}].
    Handles line folding (continuation lines begin with a space) and base64
    (attr:: value): a base64 value that decodes to printable UTF-8 is returned
    as that text, otherwise as an uppercase hex string with the b64 flag set.
    Only records that begin with a `dn:` line become entries, so ldbsearch's
    referral (`# Referral` / `ref:`) blocks are skipped. Pure — unit-tested."""
    lines = []
    for raw in text.splitlines():
        if raw[:1] == " " and lines:        # folded continuation
            lines[-1] += raw[1:]
        else:
            lines.append(raw)
    entries, cur = [], None
    for raw in lines:
        if not raw.strip():
            cur = None
            continue
        if raw.startswith("#"):
            continue
        m = re.match(r'^([A-Za-z][\w;.-]*)(::?) ?(.*)$', raw)
        if not m:
            continue
        name, sep, val = m.group(1), m.group(2), m.group(3)
        b64 = False
        if sep == "::":
            try:
                data = base64.b64decode(val)
                dec = data.decode("utf-8")
                if any(ord(c) < 32 and c not in "\t\n\r" for c in dec):
                    raise ValueError("control chars")
                val = dec
            except Exception:
                try:
                    val = base64.b64decode(val).hex().upper()
                except Exception:
                    pass
                b64 = True
        if name == "dn":
            cur = {"dn": val, "attrs": {}, "b64": {}}
            entries.append(cur)
            continue
        if cur is None:
            continue
        cur["attrs"].setdefault(name, []).append(val)
        cur["b64"].setdefault(name, []).append(b64)
    return entries

def parse_name_list(text):
    return sorted(l.strip() for l in text.splitlines() if l.strip())

def parse_gpo_listall(text):
    """samba-tool gpo listall blocks -> list of dicts."""
    gpos, cur = [], None
    for line in text.splitlines():
        m = re.match(r'^([a-z][\w ]*?)\s*:\s*(.*)$', line.strip(), re.I)
        if not m:
            continue
        key = m.group(1).strip().lower().replace(" ", "_")
        if key == "gpo":
            cur = {"gpo": m.group(2).strip()}
            gpos.append(cur)
        elif cur is not None:
            cur[key] = m.group(2).strip()
    return gpos

# ---- Group Policy registry.pol (PReg) + ADMX parsing ----------------------
# registry.pol is Windows "PReg" format: a 'PReg' magic + version, then
# records [key\0;value\0;type;size;data] with UTF-16LE strings and 4-byte LE
# ints. This is what Administrative-Template / ADMX settings compile down to,
# so parsing it lets the UI SHOW a GPO's registry policy without any Windows
# tooling. Pure function — unit-tested against captured bytes.

REG_TYPES = {1: "REG_SZ", 2: "REG_EXPAND_SZ", 3: "REG_BINARY", 4: "REG_DWORD",
             5: "REG_DWORD_BE", 7: "REG_MULTI_SZ", 11: "REG_QWORD"}
REG_TYPE_IDS = {v: k for k, v in REG_TYPES.items()}

def _reg_decode(type_id, data):
    if type_id in (1, 2):                       # REG_SZ / REG_EXPAND_SZ
        return data.decode("utf-16-le", "replace").rstrip("\x00")
    if type_id == 4:                            # REG_DWORD (LE)
        return struct.unpack("<I", data[:4])[0] if len(data) >= 4 else 0
    if type_id == 5:                            # REG_DWORD_BE
        return struct.unpack(">I", data[:4])[0] if len(data) >= 4 else 0
    if type_id == 11:                           # REG_QWORD
        return struct.unpack("<Q", data[:8])[0] if len(data) >= 8 else 0
    if type_id == 7:                            # REG_MULTI_SZ
        s = data.decode("utf-16-le", "replace").rstrip("\x00")
        return [x for x in s.split("\x00") if x]
    return list(data)                           # REG_BINARY -> byte list

def parse_preg(blob):
    """PReg registry.pol bytes -> [{keyname, valuename, type, data}]."""
    entries = []
    if len(blob) < 8 or blob[:4] != b"PReg":
        return entries
    n, i = len(blob), 8
    def u16(j):                                 # read UTF-16LE up to \0\0
        s = j
        while j + 1 < n and blob[j:j + 2] != b"\x00\x00":
            j += 2
        return blob[s:j].decode("utf-16-le", "replace"), j + 2
    SEMI = b";\x00"
    while i + 2 <= n and blob[i:i + 2] == b"[\x00":
        try:
            i += 2
            key, i = u16(i)
            if blob[i:i + 2] == SEMI: i += 2
            val, i = u16(i)
            if blob[i:i + 2] == SEMI: i += 2
            type_id = struct.unpack("<I", blob[i:i + 4])[0]; i += 4
            if blob[i:i + 2] == SEMI: i += 2
            size = struct.unpack("<I", blob[i:i + 4])[0]; i += 4
            if blob[i:i + 2] == SEMI: i += 2
            data = blob[i:i + size]; i += size
            if blob[i:i + 2] == b"]\x00": i += 2
        except (struct.error, IndexError):
            break
        entries.append({"keyname": key, "valuename": val,
                        "type": REG_TYPES.get(type_id, "REG_%d" % type_id),
                        "data": _reg_decode(type_id, data)})
    return entries

def _admx_fromstring(xml_text):
    """Parse ADMX/ADML text whose declaration may name an encoding Python does not
    know. Search.admx declares encoding='unicode' (not a registered codec), so a
    plain ET.fromstring raises LookupError -- which is NOT a ParseError, so callers
    guarding only against ParseError lose the file without a word. The declaration
    is rewritten because the text is already decoded by this point."""
    fixed = re.sub(r"(<\?xml[^>]*?encoding=)(['\"])[^'\"]*\2",
                   lambda m: m.group(1) + m.group(2) + "utf-8" + m.group(2),
                   xml_text, count=1)
    return ET.fromstring(fixed)


def _admx_local(tag):
    return tag.rsplit("}", 1)[-1]               # strip XML namespace

def _admx_value(node):
    """<enabledValue><decimal value='1'/></enabledValue> -> ('REG_DWORD', 1)."""
    for c in list(node):
        t = _admx_local(c.tag)
        if t == "decimal":
            return "REG_DWORD", int(c.get("value", "0") or 0)
        if t == "longDecimal":
            return "REG_QWORD", int(c.get("value", "0") or 0)
        if t == "string":
            return "REG_SZ", (c.text or "")
    return None, None

def parse_admx(xml_text):
    """samba/Windows ADMX -> [{id, class, key, valuename, has_enabled,
    has_disabled, enabled_type/data, disabled_type/data, elements:[...]}].
    Captures enough to write the right registry.pol entry when a policy is
    toggled Enabled/Disabled. Best-effort over the common policy shape."""
    out = []
    try:
        root = _admx_fromstring(xml_text)
    except ET.ParseError:
        return out
    for pol in root.iter():
        if _admx_local(pol.tag) != "policy":
            continue
        p = {"id": pol.get("name", ""), "class": pol.get("class", "Both"),
             "key": pol.get("key", ""), "valuename": pol.get("valueName", ""),
             "display": (pol.get("displayName", "") or "").strip("$()"),
             "explain": (pol.get("explainText", "") or "").strip("$()"),
             "has_enabled": False, "has_disabled": False,
             "enabled_type": None, "enabled_data": None,
             "disabled_type": None, "disabled_data": None, "elements": []}
        for ch in list(pol):
            t = _admx_local(ch.tag)
            if t == "enabledValue":
                p["has_enabled"] = True
                p["enabled_type"], p["enabled_data"] = _admx_value(ch)
            elif t == "disabledValue":
                p["has_disabled"] = True
                p["disabled_type"], p["disabled_data"] = _admx_value(ch)
            elif t == "elements":
                for e in list(ch):
                    kind = _admx_local(e.tag)
                    reg = {"boolean": "REG_DWORD", "decimal": "REG_DWORD",
                           "longDecimal": "REG_QWORD", "text": "REG_SZ",
                           "enum": "REG_SZ", "multiText": "REG_MULTI_SZ"}.get(kind, "REG_SZ")
                    p["elements"].append({"kind": kind, "id": e.get("id", ""),
                                          "valuename": e.get("valueName", ""),
                                          "type": reg})
        # a bare enabled policy with no explicit enabledValue still enables by
        # writing its valueName=1 (the ADMX default), so treat it as enable-able
        if p["valuename"] and not p["has_enabled"] and not p["elements"]:
            p["has_enabled"] = True
            p["enabled_type"], p["enabled_data"] = "REG_DWORD", 1
            p["has_disabled"] = True
            p["disabled_type"], p["disabled_data"] = "REG_DWORD", 0
        out.append(p)
    return out

def parse_gpo_manage_list(text):
    """Generic `gpo manage <cse> list` output -> list of non-empty lines."""
    return [l.rstrip() for l in text.splitlines() if l.strip()]

def parse_dns_zonelist(text):
    return sorted(set(m.group(1) for m in
                      re.finditer(r'pszZoneName\s*:\s*(\S+)', text)))

def parse_dns_query(text):
    """samba-tool dns query output -> [{name, type, data, ttl}]."""
    recs, name = [], ""
    for line in text.splitlines():
        m = re.match(r'\s*Name=(.*?), Records=', line)
        if m:
            name = m.group(1).strip() or "@"
            continue
        m = re.match(r'\s*([A-Z]+):\s+(.*?)\s*\(flags=[^,]*,\s*serial=\d+,\s*ttl=(\d+)\)', line)
        if m:
            recs.append({"name": name, "type": m.group(1),
                         "data": m.group(2), "ttl": int(m.group(3))})
    return recs

def parse_processes(text):
    procs = []
    for line in text.splitlines():
        m = re.match(r'^([\w()\[\]. -]+?)\s+(\d+)\s*$', line.strip())
        if m and m.group(1).lower() not in ("service:", "-" * 4):
            procs.append({"service": m.group(1).strip(), "pid": int(m.group(2))})
    return procs

def parse_domain_info(text):
    info = {}
    for line in text.splitlines():
        m = re.match(r'^([\w ]+?)\s*:\s*(.*)$', line.strip())
        if m:
            info[m.group(1).strip().lower().replace(" ", "_")] = m.group(2).strip()
    return info

