# ---- DCs: logs, tracing, RPC, promote/demote, remoting --------------------

def v_dc_list(a):
    roles = {}
    try:
        d = first_up_dc()
        rc, out, _ = podman(d, ["samba-tool", "fsmo", "show"])
        if rc == 0:
            roles = parse_fsmo(out)
    except Fail:
        pass
    dcs = []
    for i in range(1, LAB["DC_COUNT"] + 1):
        n = dc_name(i)
        held = sorted(r for r, h in roles.items() if h == n)
        dcs.append({"dc": n, "ip": ctr_ip(n) or dc_ip(i),
                    "state": ctr_state(n), "fsmo_roles": held})
    return {"dcs": dcs}

def v_dc_logs(a):
    lines = int(a.get("lines") or 80)
    rc, out, err = RUN.run(["podman", "logs", "--tail", str(lines), a["dc"]])
    return {"dc": a["dc"], "log": (out + err)[-16000:]}

def v_dc_debug(a):
    lvl = int(a["level"])
    if not 0 <= lvl <= 10:
        raise Fail("debug level must be 0..10")
    rc, out, err = podman(a["dc"], ["smbcontrol", "all", "debug", str(lvl)])
    if rc != 0:
        raise Fail(err.strip() or out.strip())
    return {"dc": a["dc"], "debug_level": lvl,
            "note": "samba log verbosity changed live; level 0 restores quiet"}

def v_dc_processes(a):
    rc, out, err = podman(a["dc"], ["samba-tool", "processes"])
    if rc != 0:
        raise Fail(err.strip() or out.strip())
    return {"dc": a["dc"], "processes": parse_processes(out)}

def v_dc_rpc(a):
    """Model of an RPC activity view: live TCP sessions into the DC's
    directory/RPC ports, plus the samba service processes serving them."""
    rc, out, _ = podman(a["dc"], ["bash", "-c",
        "ss -tn state established 2>/dev/null | awk 'NR>1{print $3, $4}'"])
    sessions = []
    for line in out.splitlines():
        parts = line.split()
        if len(parts) == 2:
            local, peer = parts
            port = local.rsplit(":", 1)[-1]
            svc = {"88": "kerberos", "135": "epmap/rpc", "389": "ldap",
                   "445": "smb", "464": "kpasswd", "636": "ldaps",
                   "3268": "gc", "3269": "gcs", "53": "dns"}.get(port, "high/rpc")
            sessions.append({"local": local, "peer": peer, "service": svc})
    rc2, out2, _ = podman(a["dc"], ["samba-tool", "processes"])
    return {"dc": a["dc"], "sessions": sessions,
            "processes": parse_processes(out2) if rc2 == 0 else []}

def v_dc_restart(a):
    rc, out, err = RUN.run(["podman", "restart", a["dc"]], timeout=180)
    if rc != 0:
        raise Fail(err.strip() or out.strip())
    return {"restarted": a["dc"],
            "note": "resolv.conf and the edy-agent are restored by the entrypoint/40-agent.sh"}

def v_dc_shell(a):
    """One-shot remote command on a DC — the 'remoting' surface."""
    rc, out, err = podman(a["dc"], ["bash", "-c", a["command"]], timeout=60)
    return {"dc": a["dc"], "rc": rc, "stdout": out[-8000:], "stderr": err[-4000:]}

def _run_dc(dom, name, ip, role, peer_ip=None):
    """podman run one DC container for `dom`. ROLE=provision (new forest) or
    join (replication partner). Additional-domain containers carry adlab.*
    labels so list_domains() can rediscover the forest from live state."""
    pass_mount = PRIMARY_LAB["ADMIN_PASS_FILE"] + ":/run/adminpass:ro"
    cmd = ["podman", "run", "-d", "--name", name, "--hostname", name,
           "--network", dom["NET"], "--ip", ip,
           "--cap-add", "SYS_ADMIN,NET_ADMIN,SYS_TIME",
           "--security-opt", "seccomp=unconfined",
           "-v", pass_mount,
           "-e", "ROLE=" + role, "-e", "REALM=" + dom["REALM"],
           "-e", "DOMAIN_NB=" + dom["DOMAIN_NB"], "-e", "DC_IP=" + ip,
           "-e", "FORWARDER=" + dom.get("FORWARDER", PRIMARY_LAB["FORWARDER"]),
           "-e", "ADMIN_PASS_FILE=/run/adminpass"]
    if peer_ip:
        cmd += ["-e", "PEER_IP=" + peer_ip]
    if not dom.get("PRIMARY"):
        cmd += ["--label", "adlab.realm=" + dom["REALM"],
                "--label", "adlab.domain_nb=" + dom["DOMAIN_NB"],
                "--label", "adlab.net=" + dom["NET"],
                "--label", "adlab.net_prefix=" + dom["NET_PREFIX"],
                "--label", "adlab.dc_base=%d" % dom["DC_BASE"],
                "--label", "adlab.slug=" + dom["SLUG"],
                "--label", "adlab.role=" + role]
        if dom.get("PARENT"):
            cmd += ["--label", "adlab.parent=" + dom["PARENT"]]
    cmd.append(PRIMARY_LAB["IMG_DC"])
    return RUN.run(cmd, timeout=180)


def _require_dc(name):
    if ctr_state(name) == "missing":
        raise Fail("no such DC container: %s" % name)


def _domain_of_dc(name):
    """Which domain a DC container belongs to — from its realm label, else the
    primary forest."""
    realm = _label(name, "adlab.realm")
    return resolve_domain(realm) if realm else _primary_domain()


def v_dc_promote(a):
    """Deploy an additional DC (replication partner) into the CURRENT domain
    (select it with --domain; default is the primary forest)."""
    dom = _cur()
    i = len(all_dcs(dom)) + 1
    while ctr_state(dc_name(i, dom)) != "missing":
        i += 1
    n, ip = dc_name(i, dom), dc_ip(i, dom)
    peer = ctr_ip(first_up_dc(dom)) or dc_ip(1, dom)
    rc, out, err = _run_dc(dom, n, ip, "join", peer_ip=peer)
    if rc != 0:
        raise Fail(err.strip() or out.strip())
    return {"promoting": n, "ip": ip, "domain": dom["REALM"],
            "note": "join runs in the background; watch: dc-logs --dc %s%s" % (
                n, "" if dom.get("PRIMARY") else " --domain " + dom["REALM"])}


def v_dc_demote(a):
    """samba-tool domain demote ON the DC, then remove its container. Refuses
    the primary provisioning DC and a domain's last DC."""
    return _demote_or_decommission(a["dc"])


def v_dc_decommission(a):
    """Decommission any DC (any domain): demote + remove its container. Refuses
    the primary dc1 and a domain's last DC — use domain-remove to destroy a
    whole forest."""
    return _demote_or_decommission(a["dc"])


def _demote_or_decommission(name):
    _require_dc(name)
    if name == "dc1":
        raise Fail("refusing to demote dc1 (primary provisioning DC and default peer)")
    dom = _domain_of_dc(name)
    alive = [d for d in all_dcs(dom) if ctr_state(d) != "missing"]
    if len(alive) <= 1:
        raise Fail("%s is the last DC of %s — use domain-remove "
                   "(optionally --backup true) to destroy the forest" % (name, dom["REALM"]))
    rc, out, err = podman_auth(name, "samba-tool domain demote", timeout=300)
    if rc != 0:
        raise Fail(err.strip() or out.strip())
    RUN.run(["podman", "rm", "-f", name])
    return {"demoted": name, "domain": dom["REALM"], "container_removed": True,
            "output": out.strip()[-600:]}


# ---- domains (multi-forest lifecycle) -------------------------------------

def v_domain_list(a):
    """Every domain (forest) in the lab, primary first, with its DCs."""
    out = []
    for d in list_domains():
        dcs = [{"name": x, "state": ctr_state(x), "ip": ctr_ip(x)} for x in all_dcs(d)]
        out.append({
            "realm": d["REALM"], "domain_nb": d["DOMAIN_NB"],
            "primary": bool(d.get("PRIMARY")), "net": d["NET"],
            "net_prefix": d.get("NET_PREFIX", ""), "slug": d.get("SLUG", ""),
            "parent": d.get("PARENT", ""),
            "dcs": dcs, "dc_count": sum(1 for x in dcs if x["state"] != "missing")})
    return {"domains": out}


def _alloc_domain_subnet():
    """Give each additional forest its own /24 under 10.44.x — first free x."""
    used = set()
    for d in list_domains():
        p = d.get("NET_PREFIX", "")
        if not d.get("PRIMARY") and p.startswith("10.44."):
            try:
                used.add(int(p.split(".")[2]))
            except (ValueError, IndexError):
                pass
    n = 1
    while n in used:
        n += 1
    return "10.44.%d" % n


def v_domain_add(a):
    """Create a new domain. Without --parent: an INDEPENDENT forest (its own
    podman network + provisioned first DC). With --parent <realm>: the new domain
    is provisioned on the PARENT's network so it can be linked to the parent's
    forest with a forest trust — samba AD cannot create an in-forest CHILD domain,
    so the parent relationship is realized as a trust (see domain-trust-create). A
    contiguous child.parent namespace best emulates a child domain."""
    realm = a["realm"].strip().upper()
    nb = a["domain_nb"].strip().upper()
    slug = (a.get("slug") or realm.split(".")[0]).strip().lower()
    parent_realm = (a.get("parent") or "").strip().upper()
    if "." not in realm:
        raise Fail("realm must be a dotted DNS domain, e.g. CORP.EXAMPLE.LAB")
    if realm.lower() == PRIMARY_LAB["REALM"].lower():
        raise Fail("%s is the primary domain" % realm)
    if any(d["REALM"].lower() == realm.lower() for d in list_domains() if not d.get("PRIMARY")):
        raise Fail("domain %s already exists (see domain-list)" % realm)

    if parent_realm:
        parent = resolve_domain(parent_realm)          # must exist (raises otherwise)
        if not parent.get("NET_PREFIX"):
            raise Fail("parent %s has no known subnet; cannot place a child on its network"
                       % parent_realm)
        # The child shares the parent's network so it can reach the parent DC for
        # a trust. Each child of a parent gets its own 10-address block from .50.
        kids = sum(1 for d in list_domains()
                   if (d.get("PARENT") or "").lower() == parent_realm.lower())
        dom = {"REALM": realm, "DOMAIN_NB": nb, "DOMAIN_DNS": realm.lower(),
               "NET": parent["NET"], "NET_PREFIX": parent["NET_PREFIX"],
               "DC_BASE": 50 + 10 * kids, "SLUG": slug, "PRIMARY": False,
               "PARENT": parent_realm,
               "FORWARDER": parent.get("FORWARDER", PRIMARY_LAB["FORWARDER"])}
        name, ip = dc_name(1, dom), dc_ip(1, dom)
        contiguous = realm.lower().endswith("." + parent_realm.lower())
        rc, out, err = _run_dc(dom, name, ip, "provision")
        if rc != 0:
            raise Fail("provision failed: " + (err.strip() or out.strip()))
        note = ("Provisioned as its own forest on %s's network (samba AD has no "
                "in-forest child domains). When provisioning finishes, link it to "
                "the parent forest with: domain-trust-create --realm %s --parent %s"
                % (parent_realm, realm, parent_realm))
        if not contiguous:
            note += (". NB: a contiguous CHILD.%s namespace best emulates a child domain"
                     % parent_realm)
        return {"domain": realm, "domain_nb": nb, "slug": slug, "parent": parent_realm,
                "network": parent["NET"], "shared_with_parent": True,
                "subnet": parent["NET_PREFIX"] + ".0/24", "dc": name, "ip": ip,
                "contiguous_namespace": contiguous, "note": note}

    net = "adlab-" + slug
    prefix = _alloc_domain_subnet()
    rc, out, err = RUN.run(["podman", "network", "create", net, "--subnet", prefix + ".0/24"])
    if rc != 0 and "already" not in (err + out).lower():
        raise Fail("network create failed: " + (err.strip() or out.strip()))
    dom = {"REALM": realm, "DOMAIN_NB": nb, "DOMAIN_DNS": realm.lower(),
           "NET": net, "NET_PREFIX": prefix, "DC_BASE": 10, "SLUG": slug,
           "PRIMARY": False, "FORWARDER": PRIMARY_LAB["FORWARDER"]}
    name, ip = dc_name(1, dom), dc_ip(1, dom)
    rc, out, err = _run_dc(dom, name, ip, "provision")
    if rc != 0:
        RUN.run(["podman", "network", "rm", net])   # roll back the network we just made
        raise Fail("provision failed: " + (err.strip() or out.strip()))
    return {"domain": realm, "domain_nb": nb, "slug": slug, "network": net,
            "subnet": prefix + ".0/24", "dc": name, "ip": ip,
            "note": "provisioning runs in the background; watch: dc-logs --dc %s --domain %s. "
                    "Add DCs with: dc-promote --domain %s" % (name, realm, realm)}


# ---- domain trusts (samba's cross-forest linkage; it has no child domains) ----

def _trust_partner_dc_ip(pdom):
    return ctr_ip(first_up_dc(pdom)) or dc_ip(1, pdom)

def v_domain_trust_create(a):
    """Establish a forest/external trust between a lab domain and a parent/partner
    domain — samba's way to link two forests (it cannot create an in-forest child
    domain). Runs on the local domain's DC and creates the trust on BOTH sides."""
    realm = a["realm"].strip().upper()
    dom = resolve_domain(realm)
    partner = (a.get("parent") or dom.get("PARENT") or "").strip().upper()
    if not partner:
        raise Fail("specify --parent (the forest to trust); this domain has no recorded parent")
    if partner.lower() == realm.lower():
        raise Fail("a domain cannot trust itself")
    pdom = resolve_domain(partner)
    ttype = (a.get("type") or "forest").lower()
    if ttype not in ("forest", "external"):
        raise Fail("type must be 'forest' or 'external'")
    direction = (a.get("direction") or "both").lower()
    if direction not in ("both", "incoming", "outgoing"):
        raise Fail("direction must be 'both', 'incoming' or 'outgoing'")
    dc = first_up_dc(dom)
    pip = _trust_partner_dc_ip(pdom)
    body = (
        "umask 077; "
        "grep -q ' {pip}$' /etc/resolv.conf || sed -i '1a nameserver {pip}' /etc/resolv.conf; "
        "af=$(mktemp /run/adlab.auth.XXXXXX); "
        "printf 'username=Administrator\\npassword=%s\\ndomain={pnb}\\n' "
        "\"$(tr -d '\\n' </run/adminpass)\" > \"$af\"; "
        "samba-tool domain trust create {partner} --type={t} --direction={d} "
        "--create-location=both -A \"$af\" --ipaddress={pip}; "
        "rc=$?; rm -f \"$af\"; exit $rc"
    ).format(pip=pip, pnb=pdom["DOMAIN_NB"], partner=shq(partner.lower()), t=ttype, d=direction)
    rc, out, err = podman(dc, ["bash", "-c", body], timeout=240)
    if rc != 0:
        raise Fail((err.strip() or out.strip())[-600:])
    return {"realm": realm, "partner": partner, "type": ttype, "direction": direction,
            "on": dc, "created": True, "output": (out or "").strip()[-500:]}

def v_domain_trust_list(a):
    """List the trusts configured on a lab domain (samba-tool domain trust list)."""
    dom = resolve_domain(a.get("realm"))
    dc = first_up_dc(dom)
    rc, out, err = podman(dc, ["samba-tool", "domain", "trust", "list"])
    if rc != 0:
        raise Fail((err.strip() or out.strip())[-400:])
    trusts = []
    for ln in (out or "").splitlines():
        nm = re.search(r'Name\[([^\]]+)\]', ln)
        if not nm:
            continue
        def _f(k, l=ln):
            m = re.search(k + r'\[([^\]]*)\]', l)
            return m.group(1) if m else ""
        trusts.append({"name": nm.group(1), "type": _f("Type"),
                       "direction": _f("Direction"), "transitive": _f("Transitive"),
                       "raw": ln.strip()})
    return {"realm": dom["REALM"], "on": dc, "trusts": trusts, "count": len(trusts)}

def v_domain_trust_delete(a):
    """Delete a trust between a lab domain and a partner (both sides)."""
    realm = a["realm"].strip().upper()
    dom = resolve_domain(realm)
    partner = (a.get("parent") or dom.get("PARENT") or "").strip().upper()
    if not partner:
        raise Fail("specify --parent (the trusted forest to remove)")
    pdom = resolve_domain(partner)
    dc = first_up_dc(dom)
    pip = _trust_partner_dc_ip(pdom)
    body = (
        "umask 077; af=$(mktemp /run/adlab.auth.XXXXXX); "
        "printf 'username=Administrator\\npassword=%s\\ndomain={pnb}\\n' "
        "\"$(tr -d '\\n' </run/adminpass)\" > \"$af\"; "
        "samba-tool domain trust delete {partner} --delete-location=both -A \"$af\" "
        "--ipaddress={pip}; rc=$?; rm -f \"$af\"; exit $rc"
    ).format(pnb=pdom["DOMAIN_NB"], partner=shq(partner.lower()), pip=pip)
    rc, out, err = podman(dc, ["bash", "-c", body], timeout=180)
    if rc != 0:
        raise Fail((err.strip() or out.strip())[-500:])
    return {"realm": realm, "partner": partner, "on": dc, "deleted": True}


def v_domain_backup(a):
    """Offline AD backup of a domain (samba-tool domain backup offline) copied
    to a tarball on the host. Works for any domain including the primary."""
    dom = resolve_domain(a["realm"])
    dc = first_up_dc(dom)
    stamp = time.strftime("%Y%m%d-%H%M%S")
    indir = "/tmp/adlab-backup-%s" % stamp
    rc, out, err = podman(dc, ["bash", "-lc",
        "rm -rf %s && mkdir -p %s && samba-tool domain backup offline --targetdir=%s"
        % (indir, indir, indir)], timeout=600)
    if rc != 0:
        raise Fail("backup failed on %s: %s" % (dc, err.strip() or out.strip()))
    rc, ls, _ = podman(dc, ["bash", "-lc", "ls -1 %s/*.tar.bz2 2>/dev/null | head -1" % indir])
    tar_in = ls.strip()
    if not tar_in:
        raise Fail("backup produced no tarball in %s" % indir)
    hostdir = "/var/lib/adlab/backups"
    os.makedirs(hostdir, exist_ok=True)
    hostpath = os.path.join(hostdir, "%s-%s.tar.bz2" % (dom["SLUG"] or "primary", stamp))
    rc, out, err = RUN.run(["podman", "cp", "%s:%s" % (dc, tar_in), hostpath], timeout=300)
    podman(dc, ["rm", "-rf", indir])
    if rc != 0:
        raise Fail("copying backup out failed: " + (err.strip() or out.strip()))
    return {"domain": dom["REALM"], "dc": dc, "backup": hostpath}


def v_domain_remove(a):
    """Destroy a whole forest: (optionally back it up first, --backup true),
    then remove every DC container and the domain's podman network. Refuses the
    primary domain — that is the lab's root forest."""
    dom = resolve_domain(a["realm"])
    if dom.get("PRIMARY"):
        raise Fail("refusing to remove the primary domain (%s) — it is the lab's "
                   "root forest; tear the whole lab down with 99-down.sh" % dom["REALM"])
    result = {"domain": dom["REALM"]}
    if str(a.get("backup", "")).lower() in ("true", "yes", "1", "on"):
        result["backup"] = v_domain_backup({"realm": dom["REALM"]})["backup"]
    removed = []
    for d in all_dcs(dom):
        if ctr_state(d) != "missing":
            RUN.run(["podman", "rm", "-f", d])
            removed.append(d)
    RUN.run(["podman", "network", "rm", dom["NET"]])
    result.update({"removed_dcs": removed, "network_removed": dom["NET"]})
    return result

