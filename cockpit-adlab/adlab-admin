def v_dc_logs(a):
    lines = int(a.get("lines") or 80)
    rc, out, err = RUN.run(["podman", "logs", "--tail", str(lines), a["dc"]])
    return {"dc": a["dc"], "log": (out + err)[-16000:]}

def v_dc_debug(a):
    lvl = int(a["level"])
    if not 0 <= lvl <= 10:
        raise Fail("debug level must be 0..10")
    rc, out, err = podman(a["dc"], ["smbcontrol", "all", "debug", str(lvl)])
    if rc != 0:
        raise Fail(err.strip() or out.strip())
    return {"dc": a["dc"], "debug_level": lvl,
            "note": "samba log verbosity changed live; level 0 restores quiet"}

def v_dc_processes(a):
    rc, out, err = podman(a["dc"], ["samba-tool", "processes"])
    if rc != 0:
        raise Fail(err.strip() or out.strip())
    return {"dc": a["dc"], "processes": parse_processes(out)}

def v_dc_rpc(a):
    """Model of an RPC activity view: live TCP sessions into the DC's
    directory/RPC ports, plus the samba service processes serving them."""
    rc, out, _ = podman(a["dc"], ["bash", "-c",
        "ss -tn state established 2>/dev/null | awk 'NR>1{print $3, $4}'"])
    sessions = []
    for line in out.splitlines():
        parts = line.split()
        if len(parts) == 2:
            local, peer = parts
            port = local.rsplit(":", 1)[-1]
            svc = {"88": "kerberos", "135": "epmap/rpc", "389": "ldap",
                   "445": "smb", "464": "kpasswd", "636": "ldaps",
                   "3268": "gc", "3269": "gcs", "53": "dns"}.get(port, "high/rpc")
            sessions.append({"local": local, "peer": peer, "service": svc})
    rc2, out2, _ = podman(a["dc"], ["samba-tool", "processes"])
    return {"dc": a["dc"], "sessions": sessions,
            "processes": parse_processes(out2) if rc2 == 0 else []}

def v_dc_restart(a):
    rc, out, err = RUN.run(["podman", "restart", a["dc"]], timeout=180)
    if rc != 0:
        raise Fail(err.strip() or out.strip())
    return {"restarted": a["dc"],
            "note": "resolv.conf and the edy-agent are restored by the entrypoint/40-agent.sh"}

def v_dc_shell(a):
    """One-shot remote command on a DC — the 'remoting' surface."""
    rc, out, err = podman(a["dc"], ["bash", "-c", a["command"]], timeout=60)
    return {"dc": a["dc"], "rc": rc, "stdout": out[-8000:], "stderr": err[-4000:]}

def v_dc_promote(a):
    """Bring up dcN+1 as a new replication partner — DC promotion."""
    i = LAB["DC_COUNT"] + 1
    while ctr_state(dc_name(i)) != "missing":
        i += 1
    n, ip = dc_name(i), dc_ip(i)
    pass_mount = admin_pass_file() + ":/run/adminpass:ro"
    rc, out, err = RUN.run([
        "podman", "run", "-d", "--name", n, "--hostname", n,
        "--network", LAB["NET"], "--ip", ip,
        "--cap-add", "SYS_ADMIN,NET_ADMIN,SYS_TIME",
        "--security-opt", "seccomp=unconfined",
        "-v", pass_mount,
        "-e", "ROLE=join", "-e", "REALM=" + LAB["REALM"],
        "-e", "DOMAIN_NB=" + LAB["DOMAIN_NB"],
        "-e", "DC_IP=" + ip, "-e", "PEER_IP=" + dc_ip(1),
        "-e", "FORWARDER=" + LAB["FORWARDER"],
        "-e", "ADMIN_PASS_FILE=/run/adminpass",
        LAB["IMG_DC"]], timeout=120)
    if rc != 0:
        raise Fail(err.strip() or out.strip())
    return {"promoting": n, "ip": ip,
            "note": "join runs in the background; watch dc-logs %s" % n}

def v_dc_demote(a):
    """samba-tool domain demote ON the DC, then remove its container."""
    if a["dc"] == dc_name(1):
        raise Fail("refusing to demote dc1 (provisioning DC and default peer)")
    rc, out, err = podman_auth(a["dc"], "samba-tool domain demote", timeout=300)
    if rc != 0:
        raise Fail(err.strip() or out.strip())
    RUN.run(["podman", "rm", "-f", a["dc"]])
    return {"demoted": a["dc"], "container_removed": True,
            "output": out.strip()[-600:]}

# ---- clients & onboarding -------------------------------------------------

def v_client_list(a):
    rows = []
    d1 = None
    try:
        d1 = first_up_dc()
    except Fail:
        pass
    accounts = set()
    if d1:
        rc, out, _ = podman(d1, ["samba-tool", "computer", "list"])
        if rc == 0:
            accounts = set(x.rstrip("$").lower() for x in parse_name_list(out))
    for i in range(1, LAB["CLIENT_COUNT"] + 1):
        n = client_name(i)
        rows.append({"name": n, "ip": ctr_ip(n) or client_ip(i),
                     "state": ctr_state(n), "joined": n in accounts})
    return {"clients": rows}

def v_client_onboard(a):
    """Create the next clientN container and join it — client onboarding."""
    i = LAB["CLIENT_COUNT"] + 1
    while ctr_state(client_name(i)) != "missing":
        i += 1
    n, ip = client_name(i), client_ip(i)
    pass_mount = admin_pass_file() + ":/run/adminpass:ro"
    rc, out, err = RUN.run([
        "podman", "run", "-d", "--name", n, "--hostname", n,
        "--network", LAB["NET"], "--ip", ip,
        "--cap-add", "SYS_ADMIN", "--security-opt", "seccomp=unconfined",
        "-v", pass_mount, LAB["IMG_CLIENT"]], timeout=120)
    if rc != 0:
        raise Fail(err.strip() or out.strip())
    peer = dc_ip((i % LAB["DC_COUNT"]) + 1)
    rc2, out2, err2 = podman(n, ["/usr/local/sbin/edy-domain-install",
        "--role", "client", "--realm", LAB["REALM"],
        "--domain-nb", LAB["DOMAIN_NB"], "--peer", peer,
        "--forwarder", LAB["FORWARDER"], "--pass-file", "/run/adminpass"],
        timeout=300)
    return {"onboarded": n, "ip": ip, "joined_via": peer,
            "join_ok": rc2 == 0,
            "join_tail": (out2 + err2).strip()[-500:]}

def v_client_remove(a):
    if not re.match(r'^client\d+$', a["name"]):
        raise Fail("only clientN containers can be removed here")
    RUN.run(["podman", "rm", "-f", a["name"]])
    try:
        podman(pdc_emulator(), ["samba-tool", "computer", "delete", a["name"]])
    except Fail:
        pass
    return {"removed": a["name"]}

