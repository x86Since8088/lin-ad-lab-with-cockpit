# --------------------------------------------------------------------------
# argument parsing, validation, audit, main
# --------------------------------------------------------------------------

def parse_args(spec, argv):
    """--name value pairs -> validated dict. Pure; raises Fail."""
    given = {}
    i = 0
    while i < len(argv):
        if not argv[i].startswith("--"):
            raise Fail("expected --arg, got %r" % argv[i])
        key = argv[i][2:]
        if i + 1 >= len(argv):
            raise Fail("missing value for --%s" % key)
        given[key] = argv[i + 1]
        i += 2
    out = {}
    for a in spec.get("args", []):
        name, typ = a["name"], a["type"]
        if typ == "password-stdin":
            continue                      # travels on stdin, never argv
        if name in given:
            v = given.pop(name)
            if typ == "int":
                try:
                    v = int(v)
                except ValueError:
                    raise Fail("--%s must be an integer" % name)
            if typ == "enum" and a.get("choices") and v not in a["choices"]:
                raise Fail("--%s must be one of: %s"
                           % (name, ", ".join(a["choices"])))
            out[name] = v
        elif a.get("required"):
            raise Fail("missing required --%s" % name)
        elif "default" in a:
            out[name] = a["default"]
    if given:
        raise Fail("unknown argument(s): %s"
                   % ", ".join("--" + k for k in given))
    return out

def audit(verb, args, ok):
    """Append one line per invocation. Argument VALUES are logged except for
    password-typed args (never present in args anyway); errors are not."""
    try:
        line = "%s %s %s %s\n" % (
            time.strftime("%Y-%m-%dT%H:%M:%S%z"), "OK " if ok else "ERR",
            verb, json.dumps(args, sort_keys=True))
        with open(AUDIT_LOG, "a") as f:
            f.write(line)
        os.chmod(AUDIT_LOG, 0o600)
    except OSError:
        pass

def main(argv):
    if len(argv) < 1 or argv[0] in ("-h", "--help"):
        print(json.dumps({"error": "usage: adlab-admin VERB [--arg value ...]",
                          "verbs": sorted(VERBS)}))
        return 2
    verb = argv[0]
    spec = VERBS.get(verb)
    if not spec:
        print(json.dumps({"error": "unknown verb %r" % verb,
                          "verbs": sorted(VERBS)}))
        return 2
    try:
        args = parse_args(spec, argv[1:])
    except Fail as e:
        print(json.dumps({"error": str(e)}))
        return 2
    try:
        result = spec["fn"](args)
        audit(verb, args, True)
        print(json.dumps(result))
        return 0
    except Fail as e:
        audit(verb, args, False)
        print(json.dumps({"error": str(e)}))
        return 1
    except Exception as e:            # noqa: BLE001 — contract: JSON always
        audit(verb, args, False)
        print(json.dumps({"error": "internal: %s" % e}))
        sys.stderr.write("adlab-admin internal error on %s: %r\n" % (verb, e))
        return 3

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
