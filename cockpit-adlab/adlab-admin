# --------------------------------------------------------------------------
# where this helper's configuration comes from  (DEPLOY-CONTRACT sections 4.3, 8.3)
# --------------------------------------------------------------------------
#
# This helper holds NO path to the samba-ad-lab project. It used to hold four,
# all naming a checkout that has since been retired, which is why a host with an
# unmounted share had a plugin that was not merely broken but ABSENT.
#
# Resolution order, and there is deliberately no fourth step:
#
#   1. $ADLAB_ENV -- TESTS ONLY. Honoured only for a non-root process, and only
#      when the file is owned by the invoking uid. A root helper ignores it and
#      says so on stderr: an environment variable that redirects a root
#      process's configuration is a privilege escalation, and the fact that this
#      file holds no secrets does not change that it holds paths root acts on.
#   2. ENV_FILE= from /etc/cockpit-adlab/install.conf, written by install.sh.
#      This is the normal path and the only one on a production host.
#   3. Nothing. Fail, naming install.conf.
#
# There is no "look for a .env beside me" step, on purpose. Resolving relative to
# this file lands in the payload when deployed and in the CHECKOUT when this is a
# dev install -- so the deployed helper would read a developer's .env the day
# somebody makes a dev install on the same host. The indirection through
# install.conf makes dev-versus-deployed a fact recorded at install time instead
# of a coincidence of where a file happens to sit.

class Fail(Exception):
    """A verb refused. main() turns it into {"error": ...} and a non-zero exit.
    Defined here, above the configuration layer, because cfg() raises it: a
    missing location is a refusal the page can render, not a crash."""


INSTALL_CONF = "/etc/cockpit-adlab/install.conf"

# Not a path. It is the value LAB["ADMIN_PASS_FILE"] carries when nothing has
# configured ADLAB_SECRET_DIR, and it is deliberately un-openable: every caller
# that needs the real file goes through admin_pass_file(), which refuses.
UNCONFIGURED = "<unconfigured>"


class ConfigError(Exception):
    """The helper cannot find out where anything is. Always names the file."""


def load_env(path):
    """Parse the DEPLOY-CONTRACT section 4.1 grammar. A strict subset of what sh,
    Python and systemd's EnvironmentFile all accept: KEY=value, optional whole-value
    double quotes, full-line '#' comments, and NO interpolation whatsoever."""
    out = {}
    try:
        fh = open(path, encoding="utf-8")
    except OSError as e:
        raise ConfigError("%s: %s" % (path, e.strerror or e))
    with fh:
        for n, raw in enumerate(fh, 1):
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            if "=" not in line:
                raise ConfigError("%s:%d: not KEY=VALUE" % (path, n))
            k, v = line.split("=", 1)
            k, v = k.strip(), v.strip()
            if not re.match(r"^[A-Z][A-Z0-9_]*$", k):
                raise ConfigError("%s:%d: bad key %r" % (path, n, k))
            if len(v) >= 2 and v[0] == v[-1] == '"':
                v = v[1:-1]
            if "$" in v or "`" in v:
                raise ConfigError(
                    "%s:%d: %s contains $ or ` - interpolation is not supported "
                    "(docs/DEPLOY-CONTRACT.md section 4.1). Write the value out in "
                    "full, or let the consumer join the two." % (path, n, k))
            if k in out:
                sys.stderr.write("warning: %s:%d: %s is set twice; last wins\n"
                                 % (path, n, k))
            out[k] = v
    return out


def _resolve_env_file():
    """The path of the .env this host is configured by. Raises ConfigError."""
    override = os.environ.get("ADLAB_ENV")
    if override:
        if os.geteuid() == 0:
            sys.stderr.write(
                "warning: ADLAB_ENV is set but ignored: a root helper takes its "
                "configuration from %s only.\n" % INSTALL_CONF)
        else:
            try:
                st = os.stat(override)
            except OSError as e:
                raise ConfigError("ADLAB_ENV=%s: %s" % (override, e.strerror or e))
            if st.st_uid != os.getuid():
                raise ConfigError(
                    "ADLAB_ENV=%s is not owned by uid %d. Refusing to read a "
                    "configuration file somebody else can write."
                    % (override, os.getuid()))
            return override
    conf = load_env(INSTALL_CONF)          # ConfigError names install.conf
    path = conf.get("ENV_FILE")
    if not path:
        raise ConfigError("%s defines no ENV_FILE=. Re-run install.sh." % INSTALL_CONF)
    return path


_ENV = None          # cached {key: value}
_ENV_FILE = None     # cached path it came from
_ENV_ERROR = None    # cached ConfigError text, so we diagnose once and identically


def env():
    """The parsed .env, cached. Raises ConfigError, always naming a file."""
    global _ENV, _ENV_FILE, _ENV_ERROR
    if _ENV is not None:
        return _ENV
    if _ENV_ERROR is not None:
        raise ConfigError(_ENV_ERROR)
    try:
        _ENV_FILE = _resolve_env_file()
        _ENV = load_env(_ENV_FILE)
    except ConfigError as e:
        _ENV_ERROR = str(e)
        raise
    return _ENV


def cfg(key):
    """One configured location, or a Fail that names the key AND the file it is
    missing from. A disappearance is never an acceptable answer here: the page
    renders this string as a configuration panel."""
    try:
        e = env()
    except ConfigError as ce:
        raise Fail("cockpit-adlab is not configured: %s  Run deploy.sh, or create "
                   "%s from .envdefault and re-run install.sh." % (ce, INSTALL_CONF))
    v = e.get(key, "")
    if not v:
        raise Fail("%s is not set in %s. Set it to the location on this host and "
                   "re-run the verb; nothing else needs restarting."
                   % (key, _ENV_FILE))
    return v


def cfg_or(key, default=UNCONFIGURED):
    """cfg() for the import-time path, where refusing is not yet an option."""
    try:
        return cfg(key)
    except Fail:
        return default


def admin_pass_file():
    """The lab's administrator credential FILE. Joined here rather than read from
    lab.env: lab.env writes it as ADMIN_PASS_FILE="$SECRET_DIR/administrator.pass"
    and this helper does not expand shell variables, so reading that line gives a
    literal dollar sign that has been mounted into containers as a path."""
    return os.path.join(cfg("ADLAB_SECRET_DIR"), "administrator.pass")


# --------------------------------------------------------------------------
# lab configuration (parsed from the lab's own lab.env / rdp.env)
# --------------------------------------------------------------------------
# Whose LOCATION comes from .env, above. The lab's settings themselves still come
# from the lab, which is the only place they are ever edited.

def load_lab(path=None, rdp_path=None):
    cfg_ = {
        "REALM": "AD.EDT1.LAB", "DOMAIN_DNS": "ad.edt1.lab",
        "DOMAIN_NB": "EDT1LAB", "DC_COUNT": 5, "CLIENT_COUNT": 10,
        "NET": "static-edt", "NET_PREFIX": "172.15.4",
        "DC_BASE": 10, "CLIENT_BASE": 20, "RDP_BASE": 30, "RDP_COUNT": 2,
        "FORWARDER": "8.8.8.8",
        "IMG_DC": "localhost/samba-ad-dc:latest",
        "IMG_CLIENT": "localhost/ad-client:latest",
    }
    # Never parsed out of lab.env -- derived from ADLAB_SECRET_DIR. See
    # admin_pass_file() for why reading it would be worse than not having it.
    cfg_["ADMIN_PASS_FILE"] = os.path.join(
        cfg_or("ADLAB_SECRET_DIR"), "administrator.pass")
    if path is None:
        path = cfg_or("ADLAB_LAB_ENV")
    if rdp_path is None:
        rdp_path = cfg_or("ADLAB_RDP_ENV")
    ints = {"DC_COUNT", "CLIENT_COUNT", "DC_BASE", "CLIENT_BASE",
            "RDP_BASE", "RDP_COUNT"}
    readable = {"REALM", "DOMAIN_DNS", "DOMAIN_NB", "DC_COUNT", "CLIENT_COUNT",
                "NET", "NET_PREFIX", "DC_BASE", "CLIENT_BASE", "RDP_BASE",
                "RDP_COUNT", "FORWARDER", "IMG_DC", "IMG_CLIENT"}
    for p in (path, rdp_path):
        try:
            with open(p) as f:
                for line in f:
                    m = re.match(r'^([A-Z_]+)="?([^"#\n]*)"?\s*(#.*)?$', line)
                    if m and m.group(1) in readable:
                        v = m.group(2).strip()
                        cfg_[m.group(1)] = int(v) if m.group(1) in ints else v
        except OSError:
            pass
    cfg_["DOMAIN_DNS"] = cfg_["REALM"].lower()
    return cfg_

LAB = load_lab()

def dc_name(i):  return "dc%d" % i
def dc_ip(i):    return "%s.%d" % (LAB["NET_PREFIX"], LAB["DC_BASE"] + i - 1)
def client_name(i): return "client%d" % i
def client_ip(i):   return "%s.%d" % (LAB["NET_PREFIX"], LAB["CLIENT_BASE"] + i - 1)
def all_dcs():   return [dc_name(i) for i in range(1, LAB["DC_COUNT"] + 1)]
def all_clients(): return [client_name(i) for i in range(1, LAB["CLIENT_COUNT"] + 1)]
def domain_dn(): return "DC=" + ",DC=".join(LAB["DOMAIN_DNS"].split("."))

