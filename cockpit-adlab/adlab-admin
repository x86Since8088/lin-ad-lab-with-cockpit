# ---- Windows member servers (offline domain join) -------------------------
#
# The lab's clientN containers join online: the container runs edy-domain-install
# with the administrator password mounted at /run/adminpass. A Windows machine
# built by an unattended installer cannot do that. The only credential an
# unattended Setup can use is one written into its answer file, and an answer
# file is, by construction, readable by whatever fetched it — so the online form
# of the join (Microsoft-Windows-UnattendedJoin/Identification) means putting a
# domain administrator password in cleartext on the provisioning network.
#
# Offline domain join removes the credential entirely. The machine account is
# created here, on the PDC emulator, and its provisioning data — domain name and
# SID, the DC to contact, and a machine password generated for that one account
# — is packaged into a blob the installer consumes. What the blob grants is
# exactly one computer account, and the join consumes it.
#
# Samba implements the provisioning side as `net offlinejoin provision`
# (4.16+); this host runs 4.23. The output is byte-compatible with djoin.exe
# /provision, which is what makes it consumable by a stock Windows answer file.
#
# THE BLOB IS A CREDENTIAL. It never enters the audit log and is never written
# to a host path by these verbs — it is returned once, on stdout, to the caller
# that asked for it, exactly like user-create's generated password.

MEMBER_NAME_RE = re.compile(r'^[A-Za-z0-9][A-Za-z0-9-]{0,14}$')


def _member_check_name(name):
    """A machine account name that Windows can actually carry.

    15 characters is the NetBIOS limit, and it is the binding constraint: a
    longer name provisions happily here and then mismatches the ComputerName
    Windows truncates it to, leaving a machine that is renamed and NOT joined.
    """
    if not MEMBER_NAME_RE.match(name or ""):
        raise Fail("machine name must be 1-15 characters of A-Z, 0-9 or '-', "
                   "and must not start with '-' (NetBIOS limit)")
    return name


def _decode_odj(b64_of_file):
    """podman exec gives us text, so the UTF-16LE savefile comes out base64ed.

    Returns the ASCII base64 blob that belongs in an answer file's
    <Provisioning> element — i.e. the file's CONTENT decoded from UTF-16,
    not a re-encoding of its bytes. Getting this wrong yields a document that
    parses and a join that silently does nothing.
    """
    raw = base64.b64decode(b64_of_file)
    if raw[:2] == b"\xff\xfe":
        raw = raw[2:]
    text = raw.decode("utf-16-le", errors="strict")
    # djoin.exe and samba both write the blob as a C wide string, so the file
    # ends with a NUL terminator. It is part of the file, not part of the
    # base64, and leaving it in produces an answer file whose <Provisioning>
    # element Windows rejects. strip() does not remove it.
    text = text.replace("\x00", "")
    text = "".join(text.split())          # the tools wrap; the XML element must not
    if not text:
        raise Fail("offline-join blob came back empty")
    # Prove it is base64 AND structurally an ODJ blob before handing it on.
    #
    # This matters more than it looks. Windows Setup's offlineServicing pass
    # reports "Successfully applied settings override to component
    # Microsoft-Windows-UnattendedJoin" for having WRITTEN the settings into the
    # image, whether or not the blob is usable — a bad one produces no error
    # anywhere and the machine simply boots into a workgroup. There is no
    # downstream diagnostic, so the check has to happen here.
    try:
        raw = base64.b64decode(text, validate=True)
    except Exception as e:
        raise Fail("offline-join blob is not valid base64: %s" % e)

    # The blob is an NDR type-serialization v1 stream (MS-RPCE 2.2.6): a
    # 16-byte private header of version=1, endianness=0x10, common-header
    # length=8, filler 0xCCCCCCCC, then a 4-byte object buffer length.
    if len(raw) < 16:
        raise Fail("offline-join blob is too short to be an ODJ structure (%d bytes)" % len(raw))
    ver, endian, hdrlen = raw[0], raw[1], struct.unpack_from("<H", raw, 2)[0]
    filler = raw[4:8]
    objlen = struct.unpack_from("<I", raw, 8)[0]
    if not (ver == 1 and endian == 0x10 and hdrlen == 8 and filler == b"\xcc\xcc\xcc\xcc"):
        raise Fail("offline-join blob is not NDR type-serialization v1 "
                   "(version=%d endianness=0x%02x header_len=%d filler=%s)"
                   % (ver, endian, hdrlen, filler.hex()))
    # The payload starts at 16: an 8-byte private header (2.2.6.2) followed by
    # an 8-byte object header (2.2.6.3) whose first field is objlen itself.
    # Comparing against len(raw)-8 instead would accept a blob truncated by up
    # to eight bytes, which is the case this check exists to catch.
    if objlen > len(raw) - 16:
        raise Fail("offline-join blob is truncated: header claims %d payload bytes, %d present"
                   % (objlen, len(raw) - 16))
    return text


def v_member_provision(a):
    """Create/refresh a machine account and return its offline-join blob."""
    name = _member_check_name(a["name"])
    reuse = str(a.get("reuse", "")).lower() in ("yes", "true", "1")
    ou = (a.get("ou") or "").strip()

    pdc = pdc_emulator()
    # The savefile is written, read back and removed inside ONE bash -c, so the
    # blob never outlives the call even if this process dies mid-verb. The name
    # is random per invocation for the same reason AUTH_WRAP's authfile is: two
    # concurrent provisions must not have one's cleanup delete the other's file.
    dest = "/run/adlab.odj.%s" % secrets.token_hex(6)
    errf = "/run/adlab.odj.%s.err" % secrets.token_hex(6)

    cmd = ("net offlinejoin provision domain=%s machine_name=%s dcname=%s"
           % (shq(LAB["DOMAIN_DNS"]), shq(name), shq(pdc)))
    if ou:
        cmd += " machine_account_ou=%s" % shq(ou)
    if reuse:
        cmd += " reuse"
    cmd += " savefile=%s" % shq(dest)

    # The blob read has to run inside the authfile's lifetime, so the whole
    # sequence is one body rather than a command followed by a separate read.
    #
    # net's own output goes to the error file, never to stdout: stdout carries
    # ONLY the base64 blob, so a chatty samba build cannot prepend a success
    # banner to the credential the caller is about to parse. (`printblob` does
    # exactly that — it writes "Successfully provisioned computer ..." and the
    # blob to the same stream — which is why savefile is used here instead.)
    body = (cmd + ' -A "$af" >/dev/null 2>' + shq(errf) +
            "; nrc=$?; "
            "if [ $nrc -eq 0 ]; then base64 -w0 < " + shq(dest) +
            "; else cat " + shq(errf) + " >&2; fi; "
            "rm -f " + shq(dest) + " " + shq(errf) + "; "
            "(exit $nrc)")
    rc, out, err = podman_auth_body(pdc, body, timeout=180)
    if rc != 0:
        raise Fail("offlinejoin provision failed on %s: %s"
                   % (pdc, (err.strip() or out.strip())[:400]))

    blob = _decode_odj(out.strip())
    return {
        "machine": name,
        "domain": LAB["DOMAIN_DNS"],
        "realm": LAB["REALM"],
        "domain_nb": LAB["DOMAIN_NB"],
        "dc": pdc,
        "ou": ou,
        "reused": reuse,
        "blob_bytes": len(blob),
        # Named to match the autounattend template's variable so an operator
        # can paste it straight into the deployment form.
        "odj_blob": blob,
        "note": ("This blob authenticates one machine account and is consumed "
                 "by the join. Treat it as a credential."),
    }


def v_member_list(a):
    """Computer accounts that are member servers, with their join evidence."""
    d = first_up_dc()
    rc, out, err = podman(d, ["samba-tool", "computer", "list"])
    if rc != 0:
        raise Fail(err.strip() or out.strip())
    names = [x.rstrip("$") for x in parse_name_list(out)]

    dcs = set(x.lower() for x in all_dcs())
    rows = []
    for n in sorted(names):
        low = n.lower()
        if low in dcs or re.match(r'^client\d+$', low) or re.match(r'^rdp\d+$', low):
            continue          # lab containers and DCs have their own tabs
        info = {"name": n, "os": "", "os_version": "", "dns": "", "last_logon": ""}
        rc2, out2, _ = podman(d, ["samba-tool", "computer", "show", n])
        if rc2 == 0:
            for line in out2.splitlines():
                if ":" not in line:
                    continue
                k, v = line.split(":", 1)
                k, v = k.strip().lower(), v.strip()
                if k == "operatingsystem":
                    info["os"] = v
                elif k == "operatingsystemversion":
                    info["os_version"] = v
                elif k == "dnshostname":
                    info["dns"] = v
                elif k == "lastlogontimestamp":
                    info["last_logon"] = v
        # operatingSystem is the ONLY one of these written by the machine
        # itself, at join time. dNSHostName is not: `net offlinejoin provision`
        # sets it when it creates the account, so treating it as evidence
        # reports every provisioned-but-never-booted machine as joined — which
        # is precisely the case this column exists to expose.
        info["joined"] = bool(info["os"])
        rows.append(info)
    return {"members": rows, "queried_on": d}


def v_member_verify(a):
    """Has this machine actually joined, or is it only provisioned?"""
    name = _member_check_name(a["name"])
    d = first_up_dc()
    rc, out, err = podman(d, ["samba-tool", "computer", "show", name])
    if rc != 0:
        return {"machine": name, "account_exists": False, "joined": False,
                "detail": (err.strip() or out.strip())[:300]}
    attrs = {}
    for line in out.splitlines():
        if ":" in line:
            k, v = line.split(":", 1)
            attrs[k.strip().lower()] = v.strip()
    # operatingSystem is written by the machine when it joins. dNSHostName is
    # set by `net offlinejoin provision` at account-creation time, so it proves
    # only that someone staged this machine — not that the machine ever booted.
    joined = bool(attrs.get("operatingsystem"))
    return {
        "machine": name,
        "account_exists": True,
        # The distinction between "we made it an account" and "the machine
        # joined" is exactly what an operator needs after an unattended install
        # that appeared to succeed.
        "joined": joined,
        "provisioned_only": (not joined),
        "operating_system": attrs.get("operatingsystem", ""),
        "operating_system_version": attrs.get("operatingsystemversion", ""),
        "dns_hostname": attrs.get("dnshostname", ""),
        "last_logon": attrs.get("lastlogontimestamp", ""),
        "queried_on": d,
    }


def v_member_deprovision(a):
    """Delete a member server's machine account."""
    name = _member_check_name(a["name"])
    if name.lower() in set(x.lower() for x in all_dcs()):
        raise Fail("%s is a domain controller; use dc-demote" % name)
    if re.match(r'^client\d+$', name.lower()):
        raise Fail("%s is a lab client container; use client-remove" % name)
    rc, out, err = podman(pdc_emulator(), ["samba-tool", "computer", "delete", name])
    if rc != 0:
        raise Fail(err.strip() or out.strip())
    return {"deprovisioned": name}


