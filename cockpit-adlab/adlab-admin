    return {"on": d, "accounts": rows, "account_count": len(rows),
            "spn_count": sum(len(r["spns"]) for r in rows)}

def v_spn_add(a):
    """setspn -S (default: refuse a duplicate, via `samba-tool spn add`) or
    setspn -A (force=true: add the value directly with ldbmodify — `samba-tool
    spn add` provides no --force). This bypasses samba-tool's own pre-check, but
    samba's samldb still enforces SPN uniqueness, so a real duplicate is refused
    with a Constraint violation."""
    d = pdc_emulator()
    spn = _valid_spn(a["spn"])
    acct = a["account"].strip()
    forced = str(a.get("force", "")).lower() in ("1", "yes", "true")
    if forced:
        dn = _spn_account(d, acct)["dn"]
        ldif = ("dn: %s\nchangetype: modify\nadd: servicePrincipalName\n"
                "servicePrincipalName: %s\n" % (dn, spn))
        rc, out, err = podman(d, ["ldbmodify", "-H", SAM], stdin=ldif)
    else:
        rc, out, err = podman(d, ["samba-tool", "spn", "add", spn, acct])
    if rc != 0:
        raise Fail((err.strip() or out.strip())[-400:])
    return {"added": spn, "account": acct, "on": d, "forced": forced}

