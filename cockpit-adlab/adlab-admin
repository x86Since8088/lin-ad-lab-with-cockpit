def _xesc(s):
    return (str(s).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
            .replace('"', "&quot;"))

def linux_admx_generate():
    """Return (admx_text, adml_text): a self-contained, lint-clean Ubuntu Linux
    ADMX (namespace Canonical.Policies.Ubuntu) plus its en-US ADML. Pure."""
    etag = {"text": "text", "decimal": "decimal", "multiText": "multiText"}
    cats_xml, pols_xml, strings, presentations = [], [], [], []
    for name, disp, parent in _LINUX_CATS:
        sid = "Cat_" + name
        if parent:
            cats_xml.append(
                '    <category name="%s" displayName="$(string.%s)">\n'
                '      <parentCategory ref="%s"/>\n    </category>' % (name, sid, parent))
        else:
            cats_xml.append('    <category name="%s" displayName="$(string.%s)"/>' % (name, sid))
        strings.append('    <string id="%s">%s</string>' % (sid, _xesc(disp)))
    for p in _LINUX_POLS:
        n = p["name"]
        strings.append('    <string id="%s">%s</string>' % (n, _xesc(p["display"])))
        strings.append('    <string id="%s_Explain">%s</string>' % (n, _xesc(p["explain"])))
        head = ('    <policy name="%s" class="%s" displayName="$(string.%s)" '
                'explainText="$(string.%s_Explain)" key="%s"'
                % (n, p["cls"], n, n, _xesc(p["key"])))
        if p["kind"] == "bool":
            pols_xml.append(
                head + ' valueName="%s">\n'
                '      <parentCategory ref="%s"/>\n'
                '      <enabledValue><decimal value="1"/></enabledValue>\n'
                '      <disabledValue><decimal value="0"/></disabledValue>\n'
                '    </policy>' % (_xesc(p["valuename"]), p["cat"]))
        else:
            eid = n + "_Elem"
            pols_xml.append(
                head + ' presentation="$(presentation.%s)">\n'
                '      <parentCategory ref="%s"/>\n'
                '      <elements>\n'
                '        <%s id="%s" valueName="%s"/>\n'
                '      </elements>\n    </policy>'
                % (n, p["cat"], etag[p["kind"]], eid, _xesc(p["valuename"])))
            if p["kind"] == "text":
                ctl = '<textBox refId="%s"><label>%s</label></textBox>' % (eid, _xesc(p["label"]))
            elif p["kind"] == "decimal":
                ctl = '<decimalTextBox refId="%s">%s</decimalTextBox>' % (eid, _xesc(p["label"]))
            else:
                ctl = '<multiTextBox refId="%s"/>' % eid
            presentations.append('    <presentation id="%s">%s</presentation>' % (n, ctl))
    admx = (
        '<?xml version="1.0" encoding="utf-8"?>\n'
        '<!-- adlab: adsys-style Ubuntu Linux administrative templates (generated) -->\n'
        '<policyDefinitions revision="1.0" schemaVersion="1.0"\n'
        '    xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">\n'
        '  <policyNamespaces>\n'
        '    <target prefix="%s" namespace="%s"/>\n'
        '  </policyNamespaces>\n'
        '  <resources minRequiredRevision="1.0"/>\n'
        '  <categories>\n%s\n  </categories>\n'
        '  <policies>\n%s\n  </policies>\n'
        '</policyDefinitions>\n'
        % (LINUX_ADMX_PREFIX, LINUX_ADMX_NS, "\n".join(cats_xml), "\n".join(pols_xml)))
    adml = (
        '<?xml version="1.0" encoding="utf-8"?>\n'
        '<policyDefinitionResources revision="1.0" schemaVersion="1.0"\n'
        '    xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">\n'
        '  <displayName>Ubuntu Linux administrative templates</displayName>\n'
        '  <description>adsys-style Linux client policy: dconf, privilege, scripts, '
        'apparmor, mount, proxy, certificate.</description>\n'
        '  <resources>\n'
        '    <stringTable>\n%s\n    </stringTable>\n'
        '    <presentationTable>\n%s\n    </presentationTable>\n'
        '  </resources>\n'
        '</policyDefinitionResources>\n'
        % ("\n".join(strings), "\n".join(presentations)))
    return admx, adml

def v_gpo_linux_seed(a):
    """Generate a self-contained Ubuntu (adsys-style) Linux ADMX and install it
    into the SYSVOL central store, so the GP editor represents Linux-targeted
    administrative templates alongside the Windows ones. Additive + idempotent.
    Install the FULL upstream adsys tree instead with admx-import-stage +
    admx-import-apply."""
    import tempfile as _tf
    import shutil as _sh
    admx_text, adml_text = linux_admx_generate()
    src = _tf.mkdtemp(prefix="adlab-linux-admx-")
    try:
        with open(os.path.join(src, LINUX_ADMX_FILE), "w") as fh:
            fh.write(admx_text)
        os.makedirs(os.path.join(src, "en-US"), exist_ok=True)
        with open(os.path.join(src, "en-US", LINUX_ADMX_FILE[:-5] + ".adml"), "w") as fh:
            fh.write(adml_text)
        lint = admx_lint(src, "en-US")
        if lint["errors"]:
            raise Fail("generated Linux ADMX did not lint: %s"
                       % "; ".join(lint["errors"][:4]))
        label = a.get("label") or "linux-ubuntu"
        res, ok = _stage_admx_dir(label, src, "en-US")
        if not ok:
            return res
        out = _apply_admx_batch(label, retire=False)
        out["seeded"] = True
        out["admx"] = LINUX_ADMX_FILE
        out["namespace"] = LINUX_ADMX_NS
        out["policies"] = res["batch"]["policies"]
        out["categories"] = len(_LINUX_CATS)
        out["lint_warnings"] = len(lint["warnings"])
        return out
    finally:
        _sh.rmtree(src, ignore_errors=True)

def _is_linux_regkey(keyname):
    """True when a registry.pol key targets a Linux ADMX namespace (adsys/GNOME).
    Pure: slash/backslash- and case-insensitive, matches a root or a child."""
    k = (keyname or "").lower().replace("/", "\\")
    return any(k == r or k.startswith(r + "\\") for r in LINUX_REG_ROOTS)

def _gpo_linux_evidence(dc, gpo):
    """Linux-targeted evidence for one GPO: registry.pol keys under a Linux ADMX
    namespace, plus samba Unix/VGP CSE preference artifacts in its SYSVOL."""
    lin_keys = []
    for e in _read_registry_pol(dc, gpo):
        if _is_linux_regkey(e.get("keyname")):
            lin_keys.append({"key": e.get("keyname"), "valuename": e.get("valuename"),
                             "class": e.get("class")})
    base = _sysvol_gpo_dir(gpo)
    rc, out, _ = podman(dc, ["bash", "-c",
        "find %s -maxdepth 4 \\( -ipath '*VGP*' -o -iname 'manifest.xml' \\) "
        "-printf '%%P\\n' 2>/dev/null | head -20" % shq(base)])
    cse = [x for x in (out or "").split("\n") if x.strip()]
    return {"gpo": gpo, "registry_keys": lin_keys, "cse_artifacts": cse,
            "linux": bool(lin_keys or cse)}

def v_gpo_linux_report(a):
    """Which GPOs carry Linux-targeted settings -- adsys/GNOME registry policy or
    samba Unix CSE preferences. Read-only; answers 'which GPOs apply Linux
    templates' next to the ADMX central-store view."""
    d = pdc_emulator()
    rc, out, err = podman_auth(d, "samba-tool gpo listall")
    if rc != 0:
        raise Fail(err.strip() or out.strip())
    gpos = parse_gpo_listall(out)
    rows = []
    for g in gpos:
        guid = g.get("gpo", "")
        ev = _gpo_linux_evidence(d, guid)
        ev["display_name"] = g.get("display_name", "")
        rows.append(ev)
    return {"on": d, "gpos": rows,
            "linux_count": sum(1 for r in rows if r["linux"]),
            "total": len(rows), "reg_roots": list(LINUX_REG_ROOTS)}


