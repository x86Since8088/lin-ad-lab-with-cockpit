# ---- Service Principal Names (Windows setspn.exe compatibility) ------------
# setspn maps onto samba's `spn` subcommand plus directory reads/writes:
#   setspn -L <acct>       -> spn-list             (ldbsearch the account)
#   setspn -S <spn> <acct> -> spn-add              (samba-tool spn add: dup-checked)
#   setspn -A <spn> <acct> -> spn-add --force true (ldbmodify: bypass samba-tool's
#                                                   pre-check; samba's samldb still
#                                                   enforces SPN uniqueness)
#   setspn -D <spn> <acct> -> spn-delete           (samba-tool spn delete)
#   setspn -Q <spn>        -> spn-query            (which account(s) hold an SPN)
#   setspn -X              -> spn-find-duplicates   (one SPN on >1 account)
# Reads use ldbsearch (no credentials, any up DC); writes run on the PDC emulator
# as root, like the object write verbs. `samba-tool spn add` has NO --force, so
# the -A path writes servicePrincipalName directly with ldbmodify. Long SPNs
# (GUID-based ones exceed 79 chars) come back LINE-FOLDED from ldbsearch, so these
# use parse_ldif_full, which unfolds — parse_ldif_entries would truncate them.
# `_ldap_escape` is the shared helper defined further down (RFC 4515).
SPN_ACCOUNT_FILTER = "(|(objectClass=user)(objectClass=computer))"

def _valid_spn(s):
    """A service principal name: serviceClass '/' instance[:port][/name], no spaces."""
    s = (s or "").strip()
    if not s or "/" not in s or any(c.isspace() for c in s):
        raise Fail("SPN must look like service/host[:port][/name] with no spaces (got %r)" % s)
    return s

def _spn_account_query(name):
    """LDAP filter matching a user/computer by sAMAccountName (a computer may be
    given with or without the trailing '$')."""
    cands = [name] + ([name + "$"] if not name.endswith("$") else [])
    ors = "".join("(sAMAccountName=%s)" % _ldap_escape(c) for c in cands)
    return "(&%s(|%s))" % (SPN_ACCOUNT_FILTER, ors)

def _spn_rows(dc, filt):
    """ldbsearch accounts matching filt -> [{account, dn, class, spns:[...]}],
    only those that carry a servicePrincipalName, sorted. Uses parse_ldif_full so
    long (line-folded) SPN values are unfolded rather than truncated."""
    rc, out, err = podman(dc, ["ldbsearch", "-H", SAM, "-b", domain_dn(), filt,
                               "sAMAccountName", "servicePrincipalName", "objectClass"])
    if rc != 0:
        raise Fail((err.strip() or out.strip())[-400:])
    rows = []
    for e in parse_ldif_full(out):
        at = e["attrs"]
        spns = at.get("servicePrincipalName", [])
        if not spns:
            continue
        cls = "computer" if "computer" in at.get("objectClass", []) else "user"
        rows.append({"account": at.get("sAMAccountName", [""])[0],
                     "dn": e["dn"], "class": cls,
                     "spns": sorted(spns, key=lambda x: x.lower())})
    rows.sort(key=lambda r: r["account"].lower())
    return rows

def _spn_account(dc, name):
    """Resolve one account name -> its parse_ldif_full entry, or Fail if absent."""
    rc, out, err = podman(dc, ["ldbsearch", "-H", SAM, "-b", domain_dn(),
                               _spn_account_query(name),
                               "sAMAccountName", "servicePrincipalName"])
    if rc != 0:
        raise Fail((err.strip() or out.strip())[-400:])
    ents = parse_ldif_full(out)
    if not ents:
        raise Fail("no user or computer account named %r" % name)
    return ents[0]

def v_spn_list(a):
    """setspn -L: the SPNs registered on one account (by sAMAccountName; a
    computer may be given with or without the trailing '$')."""
    d = first_up_dc()
    e = _spn_account(d, a["account"].strip())
    at = e["attrs"]
    return {"account": at.get("sAMAccountName", [a["account"]])[0], "dn": e["dn"],
            "on": d, "spns": sorted(at.get("servicePrincipalName", []), key=lambda x: x.lower())}

