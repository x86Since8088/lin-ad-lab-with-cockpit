def v_config(a):
    """Where this helper's configuration came from, and whether it points at
    anything. Safe to call on a completely unconfigured host -- that is the
    case it exists for."""
    out = {"install_conf": INSTALL_CONF, "env_file": None,
           "install_kind": None, "install_path": None,
           "configured": False, "error": None, "keys": []}
    try:
        conf = load_env(INSTALL_CONF)
        out["install_kind"] = conf.get("INSTALL_KIND")
        out["install_path"] = conf.get("INSTALL_PATH")
    except ConfigError as e:
        out["error"] = str(e)
    try:
        e = env()
        out["env_file"] = _ENV_FILE
        out["configured"] = True
    except ConfigError as ce:
        out["error"] = str(ce)
        e = {}
    for key, kind, why in CONFIG_KEYS:
        v = e.get(key, "")
        row = {"key": key, "value": v, "kind": kind, "help": why,
               "set": bool(v), "exists": False}
        if v:
            row["exists"] = os.path.isdir(v) if kind == "dir" else os.path.isfile(v)
        row["fix"] = ("" if row["exists"] else
                      "Deploy samba-ad-lab, or point %s at it in %s."
                      % (key, out["env_file"] or "the .env named by " + INSTALL_CONF))
        out["keys"].append(row)
    out["ok"] = out["configured"] and all(r["exists"] for r in out["keys"])
    return out

